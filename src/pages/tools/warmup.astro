---
import MainLayout from "../../layouts/MainLayout.astro";
import Snackbar from "../../components/Snackbar.tsx";
import LevelsPanel from "../../components/LevelsPanel.tsx";
import Toolbar from "../../components/Toolbar.astro";
import ToggleGroup from "../../components/ToggleGroup.jsx";
import P5Sketch from "../../components/P5Sketch.tsx";

const shapeIcons = ['circle', 'ellipse', 'square', 'triangle', 'horizontal-line', 'vertical-line'];
---

<MainLayout title="Échauffement" footer={false}>
  <P5Sketch src="warmup.js" class="sketch-container" client:load />

  <Snackbar client:load />
  <LevelsPanel client:load />
  <Toolbar>
    <ToggleGroup client:load icons={shapeIcons} selectedIcon="circle" />
  </Toolbar>
</MainLayout>

<style>
  .sketch-container {
    position: fixed;
    inset: 0;
    top: 3.5rem;
    z-index: 0;
    border-radius: 0 !important;
  }
</style>

<script>
  window.shapeSettings = {
    circle: true,
    square: false,
    triangle: false,
    'horizontal-line': false,
    'vertical-line': false,
    ellipse: false,
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.addEventListener('toggleGroupSelected', (event) => {
      if (event.detail?.icon) {
        const selected = event.detail.icon;
        Object.keys(window.shapeSettings).forEach(k => {
          window.shapeSettings[k] = (k === selected);
        });
        document.dispatchEvent(new CustomEvent('shapeSettingsUpdated', {
          detail: { settings: { ...window.shapeSettings } },
        }));
      }
    });

    document.dispatchEvent(new CustomEvent('shapeSettingsUpdated', {
      detail: { settings: { ...window.shapeSettings } },
    }));
  });
</script>
