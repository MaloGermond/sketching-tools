---
import MainLayout from "../../layouts/MainLayout.astro";
import Snackbar from "../../components/Snackbar.tsx";
import LevelsPanel from "../../components/LevelsPanel.tsx";
import Toolbar from "../../components/Toolbar.astro";
import ToggleGroup from "../../components/ToggleGroup.jsx";
import P5Sketch from "../../components/P5Sketch.tsx";

const shapeIcons = ['circle', 'ellipse', 'square', 'triangle', 'horizontal-line', 'vertical-line'];
---

<MainLayout title="Échauffement" footer={false}>
  <P5Sketch src="warmup.js" class="sketch-container" client:load />

  <Snackbar client:load />
  <LevelsPanel client:load />
  <Toolbar>
    <ToggleGroup client:load icons={shapeIcons} selectedIcon="circle" groupId="shape-toggle-group" />
  </Toolbar>
</MainLayout>

<style>
  .sketch-container {
    position: fixed;
    inset: 0;
    top: 3.5rem;
    z-index: 0;
    border-radius: 0 !important;
  }
</style>

<style is:global>
  /* Breakpoints mutuellement exclusifs : pas de dépendance à l'ordre du bundler CSS */

  /* Mobile: 2-3 outils principaux, cibles tactiles agrandies */
  @media (max-width: 767px) {
    #shape-toggle-group > button:nth-of-type(n+4) {
      display: none;
    }

    #shape-toggle-group .toggle-btn {
      width: 44px !important;
      height: 44px !important;
    }
  }

  /* Tablette: davantage d'outils, taille intermédiaire (usage stylet) */
  @media (min-width: 768px) and (max-width: 1023px) {
    #shape-toggle-group > button:nth-of-type(n+6) {
      display: none;
    }

    #shape-toggle-group .toggle-btn {
      width: 40px !important;
      height: 40px !important;
    }
  }

  /* Ordinateur: tous les outils, taille compacte (usage souris/tablette graphique) */
  @media (min-width: 1024px) {
    #shape-toggle-group .toggle-btn {
      width: 36px !important;
      height: 36px !important;
    }
  }
</style>

<script>
  window.shapeSettings = {
    circle: true,
    square: false,
    triangle: false,
    'horizontal-line': false,
    'vertical-line': false,
    ellipse: false,
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.addEventListener('toggleGroupSelected', (event) => {
      if (event.detail?.icon) {
        const selected = event.detail.icon;
        window.umami?.track('warmup_shape_select', { shape: selected });
        Object.keys(window.shapeSettings).forEach(k => {
          window.shapeSettings[k] = (k === selected);
        });
        document.dispatchEvent(new CustomEvent('shapeSettingsUpdated', {
          detail: { settings: { ...window.shapeSettings } },
        }));
      }
    });

    document.dispatchEvent(new CustomEvent('shapeSettingsUpdated', {
      detail: { settings: { ...window.shapeSettings } },
    }));
  });
</script>
