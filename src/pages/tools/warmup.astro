---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Échauffement";
const description = "Échauffez-vous avant de commencer à dessiner";
---

<MainLayout title={title}>
  <h1>{title}</h1>
  <p>{description}</p>
  
  <div style="margin: 1.5rem 0;">
    <div style="margin-bottom: 1rem;">
      <span style="margin-right: 1rem;">Formes disponibles:</span>
      <label style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="shape-circle" checked onchange="toggleShape('circle')">
        <span>Cercle</span>
      </label>
      <label style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="shape-square" checked onchange="toggleShape('square')">
        <span>Carré</span>
      </label>
      <label style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="shape-triangle" checked onchange="toggleShape('triangle')">
        <span>Triangle</span>
      </label>
      <label style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="shape-horizontal-line" checked onchange="toggleShape('horizontal-line')">
        <span>Ligne horizontale</span>
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="shape-vertical-line" checked onchange="toggleShape('vertical-line')">
        <span>Ligne verticale</span>
      </label>
    </div>
    <div>
      <span style="margin-right: 1rem;">Niveau:</span>
      <select onchange="setLevel(this.value)" style="padding: 0.5rem;">
        <option value="1">1 - Débutant</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5 - Intermédiaire</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
        <option value="9">9</option>
        <option value="10">10 - Expert</option>
      </select>
    </div>
  </div>
  
  <div id="sketch-container"></div>
  <div id="score-display" style="margin-top: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px; min-width: 200px;"></div>
  <div id="score-popup" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 100; font-size: 48px; font-weight: bold; pointer-events: none;"></div>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
  <script src="/scripts/sketches/warmup.js" client:load></script>
  <script>
    // Initialiser les checkboxes une fois le DOM chargé
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof initShapeCheckboxes === 'function') {
        initShapeCheckboxes();
      }
    });
  </script>
</MainLayout>
