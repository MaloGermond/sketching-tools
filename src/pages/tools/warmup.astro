---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";
import Scoreboard from "../../components/Scoreboard.astro";

const title = "Échauffement";
---

<MainLayout title={title}>
  <!-- Toast/Score Popup -->
  <div 
    id="score-popup"
    style="position: fixed; top: -100px; left: 50%; transform: translateX(-50%); z-index: 1000; pointer-events: none; opacity: 0;"
  >
    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; background: var(--color-white); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); border: var(--border-light); padding: var(--space-md) var(--space-lg); min-width: 200px;">
      <span style="font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); color: var(--color-gray-700); letter-spacing: 0.05em; text-transform: uppercase;">Ressemblance</span>
      <span id="score-value" style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); line-height: 1; color: var(--color-accent);"></span>
    </div>
  </div>

  <div style="position: relative; width: 100%; height: 100%;">
    <div id="sketch-container" style="width: 100%; height: 100%;"></div>
  </div>

  <Card style="position: absolute; bottom: 1rem; left: 1rem;">
    <div style="margin-bottom: 1rem;">
      <span style="margin-right: 1rem;">Formes disponibles:</span>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-circle"
          onchange="toggleShape('circle')"
        />
        <span>Cercle</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-ellipse"
          onchange="toggleShape('ellipse')"
        />
        <span>Ellipse</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-square"
          onchange="toggleShape('square')"
        />
        <span>Carré</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-triangle"
          onchange="toggleShape('triangle')"
        />
        <span>Triangle</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-horizontal-line"
          onchange="toggleShape('horizontal-line')"
        />
        <span>Ligne horizontale</span>
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.5rem;">
        <input
          type="checkbox"
          id="shape-vertical-line"
          onchange="toggleShape('vertical-line')"
        />
        <span>Ligne verticale</span>
      </label>
    </div>
    <div>
      <span style="margin-right: 1rem;">Niveau:</span>
      <select onchange="setLevel(this.value)" style="padding: 0.5rem;">
        <option value="1">1 - Centre, taille fixe</option>
        <option value="2">2 - Déplacement</option>
        <option value="3">3 - Déplacement + taille variable</option>
        <option value="4">4 - Déplacement + taille + rotation</option>
      </select>
    </div>
  </Card>

  <Scoreboard
    style="position: absolute; top: 1rem; right: 1rem; min-width: 200px; max-width: 10%"
  />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
  <script src="/scripts/sketches/warmup.js" is:inline></script>
  <script>
    // Initialiser les checkboxes une fois le DOM chargé
    document.addEventListener("DOMContentLoaded", () => {
      if (typeof initShapeCheckboxes === "function") {
        initShapeCheckboxes();
      }
    });

    // Toast/Score Popup animation logic
    (function() {
      let isAnimating = false;
      let currentTimeout = null;

      window.showTemporaryScore = function(score) {
        const popupEl = document.getElementById('score-popup');
        const valueEl = document.getElementById('score-value');
        
        if (!popupEl || !valueEl) return;
        
        // Effacer le timeout précédent
        if (currentTimeout) {
          clearTimeout(currentTimeout);
        }
        
        // Déterminer la couleur selon le score
        const color = score >= 80 
          ? 'var(--color-accent)' 
          : score >= 50 
            ? '#f59e0b' 
            : '#ef4444';
        
        valueEl.textContent = `${Math.floor(score)}%`;
        valueEl.style.color = color;
        
        // Si une animation est en cours, on la termine rapidement
        if (isAnimating) {
          popupEl.style.top = '-100px';
          popupEl.style.opacity = '0';
          
          // Attendre un peu avant de relancer
          setTimeout(() => {
            startToastAnimation(popupEl);
          }, 100);
        } else {
          startToastAnimation(popupEl);
        }
      };

      function startToastAnimation(element) {
        isAnimating = true;
        
        // Réinitialiser la position
        element.style.top = '-100px';
        element.style.opacity = '0';
        
        // Forcer le reflow
        void element.offsetHeight;
        
        // Appliquer les styles d'animation via JS (plus simple sans CSS classes)
        element.style.transition = 'top 0.3s ease-out, opacity 0.3s ease-out';
        
        // Démarrer l'animation d'apparition
        setTimeout(() => {
          element.style.top = 'var(--space-lg)';
          element.style.opacity = '1';
        }, 10);
        
        // Cacher après 2 secondes
        currentTimeout = setTimeout(() => {
          element.style.transition = 'top 0.2s ease-in, opacity 0.2s ease-in';
          element.style.top = '-100px';
          element.style.opacity = '0';
          
          // Réinitialiser après la fin de l'animation
          setTimeout(() => {
            element.style.transition = '';
            isAnimating = false;
          }, 200);
        }, 2000);
      }
    })();
  </script>
</MainLayout>
