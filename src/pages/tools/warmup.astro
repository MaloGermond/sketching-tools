---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";
import Scoreboard from "../../components/Scoreboard.astro";
import Toast from "../../components/Toast.astro";

const title = "Échauffement";
---

<MainLayout title={title}>
  <Toast toastId="score-toast" label="Ressemblance" />

  <div style="position: relative; width: 100%; height: 100%;">
    <div id="sketch-container" style="width: 100%; height: 100%;"></div>
  </div>

  <Card style="position: absolute; bottom: 1rem; left: 1rem;">
    <div style="margin-bottom: 1rem;">
      <span style="margin-right: 1rem;">Formes disponibles:</span>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-circle"
          onchange="toggleShape('circle')"
        />
        <span>Cercle</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-ellipse"
          onchange="toggleShape('ellipse')"
        />
        <span>Ellipse</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-square"
          onchange="toggleShape('square')"
        />
        <span>Carré</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-triangle"
          onchange="toggleShape('triangle')"
        />
        <span>Triangle</span>
      </label>
      <label
        style="margin-right: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;"
      >
        <input
          type="checkbox"
          id="shape-horizontal-line"
          onchange="toggleShape('horizontal-line')"
        />
        <span>Ligne horizontale</span>
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.5rem;">
        <input
          type="checkbox"
          id="shape-vertical-line"
          onchange="toggleShape('vertical-line')"
        />
        <span>Ligne verticale</span>
      </label>
    </div>
    <div>
      <span style="margin-right: 1rem;">Niveau:</span>
      <select onchange="setLevel(this.value)" style="padding: 0.5rem;">
        <option value="1">1 - Centre, taille fixe</option>
        <option value="2">2 - Déplacement</option>
        <option value="3">3 - Déplacement + taille variable</option>
        <option value="4">4 - Déplacement + taille + rotation</option>
      </select>
    </div>
  </Card>

  <Scoreboard
    style="position: absolute; top: 1rem; right: 1rem; min-width: 200px;"
  />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
  <script src="/scripts/sketches/warmup.js" is:inline></script>
  <script>
    // Initialiser les checkboxes une fois le DOM chargé
    document.addEventListener("DOMContentLoaded", () => {
      if (typeof initShapeCheckboxes === "function") {
        initShapeCheckboxes();
      }
    });
  </script>
</MainLayout>
