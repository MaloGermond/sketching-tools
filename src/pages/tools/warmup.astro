---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Échauffement";
const description = "Échauffez-vous avant de commencer à dessiner";
---

<MainLayout title={title}>
  <h1>{title}</h1>
  <p>{description}</p>
  
  <div style="margin: 1.5rem 0;">
    <div style="margin-bottom: 0.5rem;">
      <button onclick="setShape('circle')" style="margin-right: 0.5rem; padding: 0.5rem 1rem;">Cercle</button>
      <button onclick="setShape('square')" style="margin-right: 0.5rem; padding: 0.5rem 1rem;">Carré</button>
      <button onclick="setShape('triangle')" style="margin-right: 0.5rem; padding: 0.5rem 1rem;">Triangle</button>
      <button onclick="setShape('line')" style="padding: 0.5rem 1rem;">Ligne</button>
    </div>
    <button onclick="resetHistory()" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Réinitialiser historique</button>
  </div>
  
  <div id="sketch-container"></div>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
  <script src="/scripts/sketches/warmup.js" client:load></script>
</MainLayout>
