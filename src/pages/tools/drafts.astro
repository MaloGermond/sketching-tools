---
import MainLayout from "../../layouts/MainLayout.astro";
import P5Sketch from "../../components/P5Sketch";
import Toolbar from "../../components/Toolbar.astro";
import SketchToolbarActions from "../../components/SketchToolbarActions.jsx";
import PreventPullToRefresh from "../../components/PreventPullToRefresh.astro";
import KeyboardShortcuts from "../../components/KeyboardShortcuts.jsx";

// Métadonnées pour l'affichage dans le hub
const title = "Drafts";
const description = "A blank page to sketch freely in black ink";
const icon = "✏️";
const color = "blue";
---

<MainLayout title={title} footer={false}>
  <PreventPullToRefresh />
  <P5Sketch src="drafts.js" class="sketch-container" client:load />
  <KeyboardShortcuts client:load />
  <Toolbar>
    <SketchToolbarActions client:load />
  </Toolbar>
</MainLayout>

<style is:global>
  .sketch-container {
    position: fixed;
    inset: 0;
    top: 3.5rem;
    z-index: 0;
    border-radius: 0 !important;
  }
</style>
