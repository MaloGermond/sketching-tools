---
import MainLayout from "../layouts/MainLayout.astro";
import Action from "../components/Action.astro";
import Card from "../components/Card.astro";
import Toast from "../components/Toast.astro";
import Scoreboard from "../components/Scoreboard.astro";
import ToolCard from "../components/ToolCard.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import Toolbar from "../components/Toolbar.astro";

import fs from 'fs';
import path from 'path';

const title = "Dev - All Components";

// Lister tous les fichiers SVG dans public/icons/
const iconsDir = path.join(process.cwd(), 'public/icons');
const iconFiles = fs.readdirSync(iconsDir).filter(f => f.endsWith('.svg'));
const iconNames = iconFiles.map(f => f.replace('.svg', ''));
---

<MainLayout title={title}>
  <div class="p-8 max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold mb-8">All Components - Dev Page</h1>
    <p class="text-gray-600 mb-8">This page is only available in development mode.</p>

    <!-- ============================================ -->
    <!-- SECTION: Icon -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Icon</h2>
      <Card>
        <p class="text-gray-600 mb-4">SVG icon component from public/icons/.</p>
        
        <div class="flex flex-wrap gap-6">
          {iconNames.map(iconName => (
            <div class="flex flex-col items-center gap-2">
              <Icon name={iconName} size={32} class="text-purple-500" />
              <span class="text-sm text-gray-600">{iconName}</span>
            </div>
          ))}
        </div>
        
        <p class="text-gray-600 mt-6 text-sm">
          Usage: <code>&lt;Icon name="{iconNames[0] || 'icon-name'}" size={32} class="text-color" /&gt;</code>
        </p>
      </Card>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Header -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Header</h2>
      <Card>
        <Header />
      </Card>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Action (Button) -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Action (Button)</h2>
      <Card>
        <p class="text-gray-600 mb-4">Button component with variants and sizes.</p>
        
        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-medium mb-2">Variants</h3>
            <div class="flex flex-wrap gap-4">
              <Action variant="primary">Primary</Action>
              <Action variant="emphasis">Emphasis</Action>
              <Action variant="default">Default</Action>
              <Action variant="facultatif">Facultatif</Action>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-medium mb-2">Sizes</h3>
            <div class="flex flex-wrap gap-4">
              <Action size="sm">Small</Action>
              <Action size="md">Medium</Action>
              <Action size="lg">Large</Action>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-medium mb-2">With Icons</h3>
            <div class="flex flex-wrap gap-4">
              <Action icon="circle" iconPosition="left">Draw</Action>
              <Action icon="rectangle" iconPosition="right">Edit</Action>
              <Action icon="triangle">Delete</Action>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-medium mb-2">States</h3>
            <div class="flex flex-wrap gap-4">
              <Action disabled>Disabled</Action>
              <Action fullWidth variant="emphasis">Full Width</Action>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-medium mb-2">With Href (Link)</h3>
            <div class="flex flex-wrap gap-4">
              <Action href="/">Home</Action>
              <Action href="/tools/drawing-canvas" icon="circle">Drawing Tool</Action>
              <Action href="/tools/pattern-generator" icon="rectangle" variant="primary">Pattern Generator</Action>
              <Action href="/tools/warmup" icon="triangle" onClick="console.log('Navigating to warmup')">Warmup</Action>
            </div>
          </div>
        </div>
      </Card>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Card -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Card</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card>
          <h3 class="text-lg font-semibold mb-2">Default Card</h3>
          <p class="text-gray-600">This is a default card with some content.</p>
        </Card>
        <Card style="background: var(--color-gray-50);">
          <h3 class="text-lg font-semibold mb-2">Custom Background</h3>
          <p class="text-gray-600">Card with custom background color.</p>
        </Card>
        <Card>
          <h3 class="text-lg font-semibold mb-2">With Padding</h3>
          <p class="text-gray-600 p-4">Card with additional padding.</p>
        </Card>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Toast -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Toast</h2>
      <Card>
        <p class="text-gray-600 mb-4">Toast notification component.</p>
        
        <Toast toastId="dev-toast" label="Dev Toast" />


        <div class="flex flex-wrap gap-4 mt-6">
          <Action onClick="document.dispatchEvent(new CustomEvent('showToast', { detail: { score: 25 } }))">Success Toast (25%) </Action>

        <Action onClick="document.dispatchEvent(new CustomEvent('showToast', { detail: { score: 65 } }))">Success Toast (65%) </Action>
        
        <Action onClick="document.dispatchEvent(new CustomEvent('showToast', { detail: { score: 95 } }))">Success Toast (95%) </Action>
        </div>
      </Card>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Scoreboard -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Scoreboard</h2>
      <Card>
        <p class="text-gray-600 mb-4">Score history display component.</p>
        <Scoreboard />
      </Card>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: ToolCard -->
    <!-- ============================================ -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">ToolCard</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ToolCard title="Drawing Tool" description="A tool for drawing" link="/tools/drawing-canvas" />
        <ToolCard title="Pattern Generator" description="Generate patterns" link="/tools/pattern-generator" />
        <ToolCard title="Warmup" description="Warmup exercises" link="/tools/warmup" />
      </div>
    </section>

    <!-- ============================================ -->
    <!-- SECTION: Toolbar -->
    <!-- ============================================ -->

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Toolbar</h2>
        <Toolbar/>
    </section>
    
  </div>
</MainLayout>
