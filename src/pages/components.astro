---
import MainLayout from "../layouts/MainLayout.astro";
import SketchLoader from "../components/Sketch/SketchLoader.jsx";
import WarmupSketch from "../components/Sketch/WarmupSketch.jsx";

const title = "Composants";
const description = "Page de test pour les composants Sketch";
---

<MainLayout title={title}>
  <div class="max-w-6xl mx-auto p-4">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{title}</h1>
      <p class="text-gray-600">{description}</p>
    </header>

    <!-- Section pour tester le WarmupSketch -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">Warmup Sketch (Composant Preact)</h2>
      <p class="text-gray-600 mb-4">
        Ce composant encapsule le warm-up avec les modules modularisés.
        Il affiche le score, la moyenne et la forme actuelle.
      </p>
      
      <div class="bg-white rounded-lg shadow-md p-4">
        <WarmupSketch 
          client:load 
          width={800} 
          height={500}
          className="rounded border border-gray-200"
        />
      </div>
    </section>

    <!-- Section pour tester le SketchLoader -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">SketchLoader (Chargeur générique)</h2>
      <p class="text-gray-600 mb-4">
        Ce composant permet de charger n'importe quel script p5.js.
      </p>
      
      <div class="bg-white rounded-lg shadow-md p-4">
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            URL du sketch (relatif à /public) :
          </label>
          <input 
            type="text" 
            value="/scripts/sketches/warmup.js"
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
            disabled
          />
        </div>
        
        <div class="border border-gray-200 rounded h-96">
          <SketchLoader 
            client:load 
            src="/scripts/sketches/warmup.js"
            containerId="test-sketch-loader"
            className="w-full h-full"
          />
        </div>
      </div>
    </section>

    <!-- Section pour tester les modules individuellement -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">Test des Modules</h2>
      <p class="text-gray-600 mb-4">
        Ici tu peux tester chaque module indépendamment.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Test du module Drawing -->
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-semibold mb-2">Module Drawing</h3>
          <p class="text-sm text-gray-600 mb-4">
            Teste le buffer de dessin et l'état du tracé.
          </p>
          <div 
            id="drawing-test-container" 
            class="border border-gray-200 rounded h-48"
          >
            <p class="text-gray-400 p-4 text-center">
              Conteneur pour test du module Drawing
            </p>
          </div>
        </div>

        <!-- Test du module Shapes -->
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-semibold mb-2">Module Shapes</h3>
          <p class="text-sm text-gray-600 mb-4">
            Teste la génération et le rendu des formes.
          </p>
          <div 
            id="shapes-test-container" 
            class="border border-gray-200 rounded h-48"
          >
            <p class="text-gray-400 p-4 text-center">
              Conteneur pour test du module Shapes
            </p>
          </div>
        </div>

        <!-- Test du module Scoring -->
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-semibold mb-2">Module Scoring</h3>
          <p class="text-sm text-gray-600 mb-4">
            Teste le calcul du score.
          </p>
          <div 
            id="scoring-test-container" 
            class="border border-gray-200 rounded h-48"
          >
            <p class="text-gray-400 p-4 text-center">
              Conteneur pour test du module Scoring
            </p>
          </div>
        </div>

        <!-- Test du module Warmup -->
        <div class="bg-white rounded-lg shadow-md p-4">
          <h3 class="text-lg font-semibold mb-2">Module Warmup</h3>
          <p class="text-sm text-gray-600 mb-4">
            Teste l'orchestration complète.
          </p>
          <div 
            id="warmup-test-container" 
            class="border border-gray-200 rounded h-48"
          >
            <p class="text-gray-400 p-4 text-center">
              Conteneur pour test du module Warmup
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Info sur l'utilisation -->
    <section class="bg-blue-50 rounded-lg p-4">
      <h2 class="text-xl font-semibold text-blue-800 mb-2">Comment utiliser ces composants ?</h2>
      <ul class="list-disc list-inside text-blue-700 space-y-1">
        <li>
          <strong>WarmupSketch:</strong> Utilise ce composant pour intégrer le warm-up n'importe où.
          <code class="bg-blue-100 px-2 py-1 rounded text-blue-900">
            &lt;WarmupSketch width={800} height={600} /&gt;
          </code>
        </li>
        <li>
          <strong>SketchLoader:</strong> Utilise ce composant pour charger n'importe quel sketch p5.js.
          <code class="bg-blue-100 px-2 py-1 rounded text-blue-900">
            &lt;SketchLoader src="/scripts/sketches/mon-sketch.js" /&gt;
          </code>
        </li>
        <li>
          <strong>Modules:</strong> Importe les modules directement pour une utilisation avancée.
          <code class="bg-blue-100 px-2 py-1 rounded text-blue-900">
            import { WarmupOrchestrator } from '/src/modules/warmup/warmupOrchestrator.js';
          </code>
        </li>
      </ul>
    </section>
  </div>

  <!-- Script pour tester les modules -->
  <script>
    console.log("Page Components chargée - Prêt pour les tests !");
    
    // Exemple: Tester l'import des modules
    try {
      import('/src/modules/drawing/index.js').then(module => {
        console.log("✅ Module Drawing chargé avec succès");
        console.log("Fonctions disponibles:", Object.keys(module));
      });
      
      import('/src/modules/shapes/index.js').then(module => {
        console.log("✅ Module Shapes chargé avec succès");
        console.log("Fonctions disponibles:", Object.keys(module));
      });
      
      import('/src/modules/scoring/index.js').then(module => {
        console.log("✅ Module Scoring chargé avec succès");
        console.log("Fonctions disponibles:", Object.keys(module));
      });
      
      import('/src/modules/warmup/index.js').then(module => {
        console.log("✅ Module Warmup chargé avec succès");
        console.log("Fonctions disponibles:", Object.keys(module));
      });
    } catch (error) {
      console.error("Erreur lors du chargement des modules:", error);
    }
  </script>
</MainLayout>
