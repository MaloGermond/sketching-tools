---
// Page de test pour le composant Action
import Action from '../components/Action.astro';
---

<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Composant Action</title>
  <link rel="stylesheet" href="../styles/variables.css">
</head>
<body>
  <h1>Test du composant Action</h1>
  
  <h2>Variantes</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action variant="emphasis">Emphasis</Action>
    <Action variant="primary">Primary</Action>
    <Action variant="default">Default</Action>
    <Action variant="facultatif">Facultatif</Action>
  </div>

  <h2>Tailles</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action size="sm">Petit</Action>
    <Action size="md">Moyen</Action>
    <Action size="lg">Grand</Action>
  </div>

  <h2>Avec icônes</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action icon="✏️" iconPosition="left">Dessiner</Action>
    <Action icon="🗑️" iconPosition="right">Supprimer</Action>
    <Action icon="🔍">Rechercher</Action>
  </div>

  <h2>États</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action disabled>Désactivé</Action>
    <Action variant="emphasis" disabled>Emphasis Désactivé</Action>
    <Action variant="primary" disabled>Primary Désactivé</Action>
  </div>

  <h2>Pleine largeur</h2>
  <div style="margin-bottom: 2rem;">
    <Action fullWidth variant="emphasis">Bouton pleine largeur</Action>
  </div>

  <h2>Types</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action type="button">Button</Action>
    <Action type="submit">Submit</Action>
    <Action type="reset">Reset</Action>
  </div>

  <h2>Test des règles métiers</h2>
  <p>Seul le premier bouton "emphasis" et "primary" doit rester actif.</p>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action variant="emphasis">Premier Emphasis</Action>
    <Action variant="emphasis">Deuxième Emphasis (doit être désactivé)</Action>
    <Action variant="primary">Premier Primary</Action>
    <Action variant="primary">Deuxième Primary (doit être désactivé)</Action>
  </div>

  <h2>Combinaisons</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <Action variant="primary" size="lg" icon="🚀">Lancer</Action>
    <Action variant="emphasis" size="sm" icon="✅">Valider</Action>
    <Action variant="facultatif" fullWidth icon="📌">Épingler</Action>
  </div>
</body>
</html>
