---
import MainLayout from "../layouts/MainLayout.astro";
import ChangelogVersionCard from "../components/ChangelogVersionCard.astro";
import changelog from "../data/changelog.json";
---

<MainLayout title="Changelog — Sketching Tools">
  <div class="max-w-[42.5rem] mx-auto px-6 pt-16 pb-24">

    <header class="mb-14">
      <p class="text-xs font-[var(--font-weight-emphasis)] uppercase tracking-wide text-[var(--text-subdue)] mb-3">Changelog</p>
      <h1 class="text-[clamp(1.75rem,4vw,2.5rem)] font-[var(--font-weight-emphasis)] tracking-tight text-[var(--text-default)] leading-tight mb-3">
        Nouveautés & mises à jour
      </h1>
      <p class="text-md text-[var(--text-subdue)] leading-relaxed max-w-[36rem]">
        L'historique des versions de Sketching Tools : nouveautés, améliorations et corrections de bugs.
      </p>
    </header>

    <div class="flex flex-col gap-6">
      {changelog.map((entry) => (
        <ChangelogVersionCard
          version={entry.version}
          date={entry.date}
          status={entry.status}
          new={entry.new}
          improved={entry.improved}
          fixed={entry.fixed}
        />
      ))}
    </div>

  </div>
</MainLayout>
