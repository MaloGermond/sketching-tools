---
import MainLayout from "../layouts/MainLayout.astro";
import Action from "../components/Action.astro";
import ThemeSwitch from "../components/ThemeSwitch.jsx";
import TokenChip from "../components/TokenChip.tsx";

// Palette : couleurs brutes, agnostiques de l'interface (core/colors dans Penpot).
// Rien ici n'est un choix d'UI — ça vient plus loin, dans les Thèmes puis les Styles.
const grayScale = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900];
const hueSteps = [0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const paletteScales: { name: string; steps: number[] }[] = [
  { name: "gray", steps: grayScale },
  { name: "blue", steps: hueSteps },
  { name: "green", steps: hueSteps },
  { name: "yellow", steps: hueSteps },
  { name: "red", steps: hueSteps },
  { name: "purple", steps: hueSteps },
];

const semanticTokens = [
  { name: "--background", label: "Fond de page" },
  { name: "--surface-subdue", label: "Surface discrète" },
  { name: "--surface-default", label: "Surface par défaut" },
  { name: "--surface-raised", label: "Surface flottante (card)" },
  { name: "--text-default", label: "Texte principal" },
  { name: "--text-subdue", label: "Texte secondaire" },
  { name: "--border-default", label: "Bordure par défaut" },
  { name: "--border-subdue", label: "Bordure discrète" },
];

const typeScale = [
  { class: "h1", token: "--text-3xl", label: "H1 · 32px" },
  { class: "h2", token: "--text-2xl", label: "H2 · 24px" },
  { class: "h3", token: "--text-xl", label: "H3 · 20px" },
  { class: "h4", token: "--text-md", label: "H4 · 16px" },
  { class: "body-text", token: "--text-md", label: "Body · 16px" },
  { class: "label", token: "--text-sm", label: "Label · 14px" },
  { class: "caption", token: "--text-xs", label: "Caption · 12px" },
];

const exportableTokens = [
  ...paletteScales.flatMap((s) => s.steps.map((step) => `--color-${s.name}-${step}`)),
  "--color-accent",
  ...semanticTokens.map((t) => t.name),
  "--text-success",
  "--text-error",
  "--text-warning",
  "--text-xs",
  "--text-sm",
  "--text-md",
  "--text-lg",
  "--text-xl",
  "--text-2xl",
  "--text-3xl",
];

// Styles : tokens propres à un composant, qui puisent dans les tokens de thème
// (jamais directement dans la palette brute). Hiérarchie : Palette → Thèmes → Styles.
// `kind` détermine l'illustration isolée d'une seule propriété à la fois
// (ticket #61) : background (fond seul), border (bordure seule — couvre aussi
// le stroke), label (couleur de texte seule), radius (le cadre lui-même prend
// le rayon et se surligne).
const componentStyles: {
  component: string;
  description: string;
  tokens: { name: string; kind: "background" | "border" | "label" | "radius"; refToken: string }[];
}[] = [
  {
    component: "Action",
    description: "Bouton / élément interactif générique",
    tokens: [
      { name: "--action-bg", kind: "background", refToken: "--surface-default" },
      { name: "--action-border", kind: "border", refToken: "--border-default" },
      { name: "--action-label", kind: "label", refToken: "--text-default" },
      { name: "--action-corner", kind: "radius", refToken: "--radius-lg" },
    ],
  },
  {
    component: "ToolCard",
    description: "Carte outil affichée sur la home",
    tokens: [
      { name: "--toolCard-background", kind: "background", refToken: "--surface-subdue" },
      { name: "--toolCard-border", kind: "border", refToken: "--border-subdue" },
    ],
  },
  {
    component: "Footer",
    description: "Pied de page — toujours sombre, quel que soit le thème actif",
    tokens: [
      { name: "--footer-background", kind: "background", refToken: "--background-dark" },
    ],
  },
  {
    component: "Main",
    description: "Fond de la zone de contenu principal",
    tokens: [
      { name: "--main-background", kind: "background", refToken: "--background" },
    ],
  },
  {
    component: "Sketch",
    description: "Canvas p5.js (warmup) — fond et trait dessiné à la main",
    tokens: [
      { name: "--sketch-stroke", kind: "border", refToken: "--text-default" },
    ],
  },
];

exportableTokens.push(
  ...componentStyles.flatMap((c) => c.tokens.map((t) => t.name)),
);
---

<MainLayout title="Style — Sketching Tools">
  <div class="style-page">

    <header class="style-header">
      <p class="eyebrow">Design system</p>
      <h1 class="title">Style</h1>
      <p class="intro">
        Palette de couleurs, typographie et tokens partagés par les deux thèmes.
        Source de vérité : <code>src/styles/tailwindcss.css</code>, synchronisée avec la
        librairie de tokens Penpot.
      </p>
      <div class="header-actions">
        <ThemeSwitch client:load />
        <Action id="export-btn" variant="default">Copier les tokens CSS</Action>
      </div>
    </header>

    <!-- Palette — couleurs brutes, agnostiques de l'interface -->
    <section class="style-section">
      <h2 class="section-title">Palette de couleurs</h2>
      <p class="section-desc">
        Couleurs brutes (core/colors), sans rôle d'interface — ce ne sont pas des « couleurs
        de thème » : ce rôle est assigné plus loin, dans les Thèmes ci-dessous puis les
        Styles, qui puisent dans cette palette.
      </p>
      {paletteScales.map((s) => (
        <div class="scale-row">
          {s.steps.map((step) => (
            <div class="scale-swatch">
              <div class="scale-color" style={`background: var(--color-${s.name}-${step});`} />
              <p class="scale-label">{s.name}-{step}</p>
            </div>
          ))}
        </div>
      ))}
    </section>

    <!-- Thèmes — tokens sémantiques qui puisent dans la palette, comparatif Light / Dark -->
    <section class="style-section">
      <h2 class="section-title">Thèmes</h2>
      <p class="section-desc">
        Tokens sémantiques qui puisent dans la palette ci-dessus. Ils s'inversent
        automatiquement selon le thème actif ; comparaison ci-dessous.
      </p>
      <div class="theme-compare">
        <div class="theme-pane" data-theme="light">
          <p class="pane-label">Light</p>
          <div class="swatch-grid">
            {semanticTokens.map((t) => (
              <div class="swatch">
                <div class="swatch-color" style={`background: var(${t.name}); border: 1px solid var(--border-default);`} />
                <p class="swatch-name">{t.label}</p>
                <p class="swatch-var">{t.name}</p>
              </div>
            ))}
          </div>
          <div class="preview-card">
            <p class="h2" style="margin-bottom: 0.25rem;">Un titre de section</p>
            <p class="body-text">Texte de paragraphe pour vérifier le contraste et la lisibilité sur ce fond.</p>
            <div class="preview-actions">
              <Action variant="primary" size="sm">Primaire</Action>
              <Action variant="default" size="sm">Default</Action>
              <Action variant="facultatif" size="sm">Facultatif</Action>
            </div>
          </div>
        </div>
        <div class="theme-pane" data-theme="dark">
          <p class="pane-label">Dark</p>
          <div class="swatch-grid">
            {semanticTokens.map((t) => (
              <div class="swatch">
                <div class="swatch-color" style={`background: var(${t.name}); border: 1px solid var(--border-default);`} />
                <p class="swatch-name">{t.label}</p>
                <p class="swatch-var">{t.name}</p>
              </div>
            ))}
          </div>
          <div class="preview-card">
            <p class="h2" style="margin-bottom: 0.25rem;">Un titre de section</p>
            <p class="body-text">Texte de paragraphe pour vérifier le contraste et la lisibilité sur ce fond.</p>
            <div class="preview-actions">
              <Action variant="primary" size="sm">Primaire</Action>
              <Action variant="default" size="sm">Default</Action>
              <Action variant="facultatif" size="sm">Facultatif</Action>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Styles — tokens propres à chaque composant, qui puisent dans les tokens de thème -->
    <section class="style-section">
      <h2 class="section-title">Styles</h2>
      <p class="section-desc">
        Palette (couleurs brutes, agnostiques de l'interface) → Thèmes (tokens sémantiques
        qui puisent dans la palette) → Styles (ci-dessous : tokens propres à chaque composant,
        qui puisent dans les tokens de thème — jamais directement dans la palette).
      </p>
      <div class="component-styles">
        {componentStyles.map((c) => (
          <div class="component-group">
            <p class="component-title">{c.component}</p>
            <p class="component-desc">{c.description}</p>
            <div class="token-chip-row">
              {c.tokens.map((t) => (
                <TokenChip kind={t.kind} value={`var(${t.name})`} name={t.name} refToken={t.refToken} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typographie -->
    <section class="style-section">
      <h2 class="section-title">Typographie</h2>
      <p class="section-desc">Échelle strictement croissante — <code>--text-xs</code> à <code>--text-3xl</code>.</p>
      <div class="type-scale">
        {typeScale.map((t) => (
          <div class="type-row">
            <span class={`type-sample ${t.class}`}>Dessiner, esquisser, s'échauffer</span>
            <span class="type-meta">{t.label} · <code>{t.token}</code></span>
          </div>
        ))}
      </div>
    </section>

  </div>
</MainLayout>

<script define:vars={{ exportableTokens }} is:inline>
  document.getElementById('export-btn')?.addEventListener('click', (event) => {
    const btn = event.currentTarget;
    const original = btn.textContent;
    const styles = getComputedStyle(document.documentElement);
    const lines = exportableTokens.map((name) => {
      const value = styles.getPropertyValue(name).trim();
      return `  ${name}: ${value};`;
    });
    const css = `:root {\n${lines.join('\n')}\n}`;

    const done = () => {
      btn.textContent = 'Copié ✓';
      setTimeout(() => { btn.textContent = original; }, 1800);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(css).then(done).catch(() => {});
    }
  });
</script>

<style>
  .style-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .style-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subdue);
  }

  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subdue);
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-default);
    margin-bottom: 0.75rem;
  }

  .intro {
    font-size: var(--text-md);
    color: var(--text-subdue);
    max-width: 40rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .intro code {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: var(--text-sm);
    background: var(--surface-subdue);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-default);
    margin-bottom: 0.375rem;
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--text-subdue);
    margin-bottom: 1.25rem;
  }

  .section-desc code {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: var(--text-xs);
    background: var(--surface-subdue);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  /* Comparatif light/dark */
  .theme-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .theme-pane {
    background: var(--background);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .pane-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subdue);
    margin-bottom: 0.875rem;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .swatch-color {
    width: 100%;
    height: 2.5rem;
    border-radius: var(--radius-sm);
  }

  .swatch-name {
    font-size: var(--text-xs);
    color: var(--text-default);
    margin-top: 0.375rem;
  }

  .swatch-var {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.6875rem;
    color: var(--text-subdue);
  }

  .preview-card {
    background: var(--surface-raised);
    border: 1px solid var(--border-subdue);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .preview-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .theme-compare {
      grid-template-columns: 1fr;
    }
  }

  /* Échelles de couleur */
  .scale-row {
    display: flex;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .scale-swatch {
    width: 4.5rem;
  }

  .scale-color {
    width: 100%;
    height: 3rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subdue);
  }

  .scale-label {
    font-size: 0.6875rem;
    color: var(--text-subdue);
    margin-top: 0.25rem;
    text-align: center;
    font-family: 'SF Mono', Monaco, monospace;
  }

  /* Styles (tokens par composant) — carte de référence toujours sombre,
     standardisée, pour comparer les tokens indépendamment du thème actif. */
  .component-styles {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .component-group {
    background: var(--background-dark);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .component-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-light);
  }

  .component-desc {
    font-size: var(--text-xs);
    color: var(--text-light-subdue);
    margin-bottom: 1.25rem;
  }

  .token-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  /* Typographie */
  .type-scale {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .type-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subdue);
    flex-wrap: wrap;
  }

  .type-meta {
    font-size: var(--text-xs);
    color: var(--text-subdue);
    white-space: nowrap;
  }

  .type-meta code {
    font-family: 'SF Mono', Monaco, monospace;
  }
</style>
