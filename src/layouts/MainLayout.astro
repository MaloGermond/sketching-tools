---
import Header from "../components/Header.astro";
import '../styles/typography.css';
import '../styles/tailwindcss.css';

interface Props {
  title?: string;
}

const { title = "Sketching Tools" } = Astro.props;
const f = `${import.meta.env.BASE_URL}fonts/PPNeueMontreal`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <Fragment set:html={`<style>
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Thin.woff2') format('woff2'); font-weight: 100; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-ThinItalic.woff2') format('woff2'); font-weight: 100; font-style: italic; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Book.woff2') format('woff2'); font-weight: 450; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
    @font-face { font-family: 'PP Neue Montreal'; src: url('${f}/PPNeueMontreal-BoldItalic.woff2') format('woff2'); font-weight: 700; font-style: italic; font-display: swap; }
  </style>`} />
</head>
<body class="flex flex-col min-h-screen">
  <Header />
  <main class="flex-1 pt-16">
    <slot />
  </main>
</body>
</html>
