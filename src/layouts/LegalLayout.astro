---
import MainLayout from './MainLayout.astro';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<MainLayout title={`${title} — Sketching Tools`}>
  <div class="legal-page">
    <header class="legal-header">
      <p class="legal-tag">Légal</p>
      <h1 class="legal-title">{title}</h1>
      {description && <p class="legal-desc">{description}</p>}
      {lastUpdated && <p class="legal-date">Dernière mise à jour : {lastUpdated}</p>}
    </header>

    <div class="legal-divider"></div>

    <div class="legal-body">
      <slot />
    </div>
  </div>
</MainLayout>

<style>
  .legal-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .legal-header {
    margin-bottom: 2rem;
  }

  .legal-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin-bottom: 0.75rem;
  }

  .legal-title {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-gray-900);
    margin-bottom: 0.5rem;
  }

  .legal-desc {
    font-size: 1rem;
    color: var(--color-gray-500);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .legal-date {
    font-size: 0.8125rem;
    color: var(--color-gray-400);
  }

  .legal-divider {
    height: 1px;
    background: var(--color-gray-200);
    margin-bottom: 2.5rem;
  }

  /* Prose styles for markdown content */
  .legal-body :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .legal-body :global(h3) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-gray-700);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .legal-body :global(p) {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .legal-body :global(ul), .legal-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .legal-body :global(li) {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.75;
    margin-bottom: 0.375rem;
  }

  .legal-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--color-gray-800);
  }
</style>
