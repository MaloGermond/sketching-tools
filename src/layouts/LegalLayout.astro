---
import MainLayout from './MainLayout.astro';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<MainLayout title={`${title} — Sketching Tools`}>
  <div class="legal-page">
    <header class="legal-header">
      <p class="legal-tag">Legal</p>
      <h1 class="legal-title">{title}</h1>
      {lastUpdated && <p class="legal-date">Last updated: {lastUpdated}</p>}
    </header>

    <div class="legal-body">
      <slot />
    </div>
  </div>
</MainLayout>

<style>
  .legal-page {
    max-width: 46rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .legal-header {
    margin-bottom: 3rem;
  }

  .legal-tag {
    font-size: 0.875rem;
    font-weight: 100;
    color: #000000;
    margin-bottom: 0.5rem;
  }

  .legal-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .legal-date {
    font-size: 0.875rem;
    font-weight: 400;
    color: #6f859c;
  }

  /* Prose */
  .legal-body :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 0.625rem;
  }

  .legal-body :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .legal-body :global(p) {
    font-size: 1rem;
    font-weight: 400;
    color: #6f859c;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .legal-body :global(ul), .legal-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .legal-body :global(li) {
    font-size: 1rem;
    color: #6f859c;
    line-height: 1.75;
    margin-bottom: 0.375rem;
  }

  .legal-body :global(a) {
    color: #111827;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-body :global(strong) {
    font-weight: 600;
    color: #111827;
  }
</style>
