---
import MainLayout from './MainLayout.astro';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
}

const { title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const navItems = [
  { label: 'Conditions Générales d\'Utilisation', href: `${base}/legal/terms-and-conditions` },
  { label: 'Politique de Confidentialité', href: `${base}/legal/privacy-policy` },
];
---

<MainLayout title={`${title} — Sketching Tools`}>
  <div class="legal-layout">

    <aside class="legal-sidebar">
      <p class="sidebar-group">Legal</p>
      <nav class="sidebar-nav">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`sidebar-link ${currentPath === item.href ? 'is-active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </aside>

    <div class="legal-main">
      <div class="legal-body">
        <slot />
      </div>
    </div>

  </div>
</MainLayout>

<style>
  .legal-layout {
    max-width: 62rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Sidebar */
  .legal-sidebar {
    position: sticky;
    top: 5.5rem;
  }

  .sidebar-group {
    font-size: 0.75rem;
    font-weight: var(--font-weight-emphasis);
    color: var(--text-default);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-link {
    font-size: 0.875rem;
    font-weight: var(--font-weight-subdue);
    color: var(--text-subdue);
    text-decoration: none;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    transition: color 150ms ease, background 150ms ease;
  }

  .sidebar-link:hover {
    color: var(--text-default);
    background: var(--surface-default);
  }

  .sidebar-link.is-active {
    color: var(--text-default);
    font-weight: var(--font-weight-default);
    background: var(--surface-subdue);
  }

  /* Main */
  .legal-main {
    min-width: 0;
  }

  /* Prose */
  .legal-body :global(h1) {
    font-size: 2.5rem;
    font-weight: var(--font-weight-emphasis);
    color: var(--text-default);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .legal-body :global(h2) {
    font-size: 1.375rem;
    font-weight: var(--font-weight-emphasis);
    color: var(--text-default);
    margin-top: 2.5rem;
    margin-bottom: 0.625rem;
  }

  .legal-body :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-default);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .legal-body :global(p) {
    font-size: 1rem;
    font-weight: var(--font-weight-subdue);
    color: var(--text-subdue);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .legal-body :global(ul), .legal-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .legal-body :global(li) {
    font-size: 1rem;
    color: var(--text-subdue);
    line-height: 1.75;
    margin-bottom: 0.375rem;
  }

  .legal-body :global(a) {
    color: var(--text-default);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-body :global(strong) {
    font-weight: 600;
    color: var(--text-default);
  }

  .legal-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }

  .legal-body :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--text-default);
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--surface-default);
  }

  .legal-body :global(td) {
    color: var(--text-subdue);
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--surface-default);
    vertical-align: top;
  }
</style>
