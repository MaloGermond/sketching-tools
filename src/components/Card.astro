---
// Définis les props attendues
interface Props {
  title?: string;
  style?: string;
}

const { title, style, children } = Astro.props;

 const defaultStyle = {
    background: 'rgba(255, 255, 255, 0.9)',
    padding: '1rem',
    borderRadius: '8px',
    boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
    zIndex: 10,
    ...style, // Écrase les styles par défaut avec ceux passés en props
  };

---

<div style={defaultStyle}>
  {title && <h2 style="margin: 0 0 0.5rem 0; font-size: 1rem;">{title}</h2>}
  <slot/>
</div>