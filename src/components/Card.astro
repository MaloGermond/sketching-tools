---
interface Props {
  title?: string;
  children?: any;
}

const { title } = Astro.props;
---

<div style="background: rgba(255, 255, 255, 0.9); padding: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
  {title && <h2 style="margin: 0 0 0.5rem 0; font-size: 1rem;">{title}</h2>}
  <slot />
</div>
