---
// Définis les props attendues
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={[
  className,
  'card'
]}>
  {title && <h2 class="card-title">{title}</h2>}
  <slot/>
</div>

<style>
  .card {
    background: var(--bg-card);
    margin: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-xl);
    z-index: 10;
  }
  
  .card-title {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
  }
  
  .bg-gray-50 {
    background: var(--color-gray-50);
  }
</style>
