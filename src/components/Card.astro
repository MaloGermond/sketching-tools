---
interface Props {
  title?: string;
  class?: string;
  id?: string;
}

const { title, class: className, id } = Astro.props;
---

<div
  id={id}
  class:list={[
    'bg-white rounded-xl border border-gray-200 p-4',
    className,
  ]}
>
  {title && <h2 class="h4 mb-3">{title}</h2>}
  <slot />
</div>
