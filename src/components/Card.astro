---
interface Props {
  title?: string;
  class?: string;
  id?: string;
}

const { title, class: className, id } = Astro.props;
---

<div
  id={id}
  class:list={['bg-[var(--surface-raised)] border border-[var(--border-subdue)] rounded-xl p-4', className]}
>
  {title && <h2 class="h4 mb-3">{title}</h2>}
  <slot />
</div>
