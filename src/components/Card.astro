---
// Définis les props attendues
interface Props {
  title?: string;
  style?: string;
}

const { title, style, children } = Astro.props;

const defaultStyle = "background: rgba(255, 255, 255, 0.9); margin: 1rem; padding: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); z-index: 10;"

---

<div style={defaultStyle + " " + (style || "")}>
  {title && <h2 style="margin: 0 0 0.5rem 0; font-size: 1rem;">{title}</h2>}
  <slot/>
</div>