---
// Définis les props attendues
interface Props {
  title?: string;
  style?: string;
}

const { title, style } = Astro.props;

const defaultStyle = "background: var(--bg-card); border: var(--border-subtle); margin: var(--space-sm); padding: var(--space-md); border-radius: var(--radius-xl); z-index: 10; box-shadow: var(--shadow-md);"

---

<div style={defaultStyle + " " + (style || "")}>
  {title && <h2 style="margin: 0 0 0.5rem 0; font-size: 1rem;">{title}</h2>}
  <slot/>
</div>