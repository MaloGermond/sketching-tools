---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  color?: string;
  track?: boolean;
}

const { title, description, href, icon, color = 'gray', track = false } = Astro.props;

const iconBg: Record<string, string> = {
  blue:   '#EFF6FF',
  orange: '#FFF7ED',
  green:  '#F0FDF4',
  purple: '#FAF5FF',
  gray:   'var(--color-gray-100)',
};

const iconColor: Record<string, string> = {
  blue:   '#2563EB',
  orange: '#EA580C',
  green:  '#16A34A',
  purple: '#7E22CE',
  gray:   'var(--color-gray-500)',
};

const bg = iconBg[color] ?? iconBg.gray;
const fg = iconColor[color] ?? iconColor.gray;
---

<a
  href={href}
  class="group flex items-center gap-3.5 py-3.5 px-4 bg-[var(--toolCard-background)] border border-[var(--toolCard-border)] rounded-lg no-underline [transition:box-shadow_180ms_ease,border-color_180ms_ease,transform_180ms_ease] hover:shadow-[0_4px_12px_rgb(0_0_0_/_0.07),0_1px_3px_rgb(0_0_0_/_0.05)] hover:border-[var(--border-default)] hover:-translate-y-px"
  {...(track && { 'data-umami-event': 'tool_open', 'data-umami-event-tool': title })}
>
  <div class="w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0" style={`background: ${bg};`}>
    <span class="text-xl leading-none" style={`color: ${fg};`}>{icon}</span>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-md font-medium text-[var(--text-default)] leading-[1.3] mb-0.5 whitespace-nowrap overflow-hidden text-ellipsis">{title}</p>
    <p class="text-sm text-[var(--text-subdue)] leading-snug whitespace-nowrap overflow-hidden text-ellipsis">{description}</p>
  </div>
  <svg
    class="text-[var(--border-default)] shrink-0 [transition:color_180ms_ease,transform_180ms_ease] group-hover:text-[var(--text-subdue)] group-hover:translate-x-0.5"
    width="14" height="14" viewBox="0 0 14 14" fill="none"
  >
    <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>
