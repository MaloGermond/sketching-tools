---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  color?: string;
}

const { title, description, href, icon, color = 'gray' } = Astro.props;

const iconBg: Record<string, string> = {
  blue:   '#EFF6FF',
  orange: '#FFF7ED',
  green:  '#F0FDF4',
  purple: '#FAF5FF',
  gray:   '#F2F4F6',
};

const iconColor: Record<string, string> = {
  blue:   '#2563EB',
  orange: '#EA580C',
  green:  '#16A34A',
  purple: '#7E22CE',
  gray:   '#6F859C',
};

const bg = iconBg[color] ?? iconBg.gray;
const fg = iconColor[color] ?? iconColor.gray;
---

<a href={href} class="tool-card">
  <div class="tool-icon-wrap" style={`background: ${bg};`}>
    <span class="tool-icon" style={`color: ${fg};`}>{icon}</span>
  </div>
  <div class="tool-body">
    <p class="tool-title">{title}</p>
    <p class="tool-desc">{description}</p>
  </div>
  <svg class="tool-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none">
    <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>

<style>
  .tool-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    background: #ffffff;
    border: 1px solid #e4e7eb;
    border-radius: 12px;
    text-decoration: none;
    transition: box-shadow 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .tool-card:hover {
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.07), 0 1px 3px rgb(0 0 0 / 0.05);
    border-color: #BFCBD6;
    transform: translateY(-1px);
  }

  .tool-icon-wrap {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tool-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .tool-body {
    flex: 1;
    min-width: 0;
  }

  .tool-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #111827;
    line-height: 1.3;
    margin-bottom: 0.125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-desc {
    font-size: 0.8125rem;
    color: #6F859C;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-arrow {
    color: #BFCBD6;
    flex-shrink: 0;
    transition: color 180ms ease, transform 180ms ease;
  }

  .tool-card:hover .tool-arrow {
    color: #6F859C;
    transform: translateX(2px);
  }
</style>
