---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  color?: string;
}

const { title, description, href} = Astro.props;

import Card from "../components/Card.astro";
---

<a href={href} class="min-w-[250px] w-full">
  <Card class="shadow-transparent hover:shadow-(--shadow-md) transition-shadow duration-350">
    <div class="flex flex-col p-(--space-sm) gap-2">
      <div class="h-32 bg-(--bg-thumbnail) rounded-md"></div>
      <div class="flex flex-col">
        <h3 class="text-lg">{title}</h3>
        <p class="text-sm ">{description}</p>
    </div>
    </div>
  </Card>
</a>
