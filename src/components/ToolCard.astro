---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  color?: string;
}

const { title, description, href, icon, color = 'gray' } = Astro.props;

const gradients: Record<string, string> = {
  blue:   'linear-gradient(145deg, #eff6ff 0%, #dbeafe 100%)',
  orange: 'linear-gradient(145deg, #fff7ed 0%, #fed7aa 100%)',
  green:  'linear-gradient(145deg, #f0fdf4 0%, #bbf7d0 100%)',
  purple: 'linear-gradient(145deg, #faf5ff 0%, #e9d5ff 100%)',
  gray:   'linear-gradient(145deg, #fafaf9 0%, #f5f5f4 100%)',
};

const gradient = gradients[color] ?? gradients.gray;
---

<a href={href} class="tool-card-link">
  <article class="tool-card">
    <div class="tool-thumbnail" style={`background: ${gradient};`}>
      {icon && <span class="tool-icon">{icon}</span>}
    </div>
    <div class="tool-footer">
      <div class="tool-info">
        <h3 class="tool-title">{title}</h3>
        <p class="tool-description">{description}</p>
      </div>
      <svg class="tool-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </article>
</a>

<style>
  .tool-card-link {
    display: block;
    text-decoration: none;
  }

  .tool-card {
    background: var(--bg-card);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: box-shadow 200ms ease, transform 200ms ease, border-color 200ms ease;
  }

  .tool-card-link:hover .tool-card {
    box-shadow: var(--shadow-elevated);
    transform: translateY(-2px);
    border-color: var(--color-gray-300);
  }

  .tool-thumbnail {
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .tool-icon {
    font-size: 2.75rem;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.08));
    transition: transform 200ms ease;
  }

  .tool-card-link:hover .tool-icon {
    transform: scale(1.08);
  }

  .tool-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem 1rem;
    border-top: 1px solid var(--color-gray-100);
  }

  .tool-info {
    flex: 1;
    min-width: 0;
  }

  .tool-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-gray-900);
    margin-bottom: 0.125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-description {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    line-height: 1.45;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-arrow {
    color: var(--color-gray-300);
    flex-shrink: 0;
    transition: color 200ms ease, transform 200ms ease;
  }

  .tool-card-link:hover .tool-arrow {
    color: var(--color-gray-600);
    transform: translateX(2px);
  }
</style>
