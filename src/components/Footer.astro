---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="w-full bg-[var(--footer-background)]">
  <div class="max-w-[62rem] mx-auto py-12 px-6 pb-8 flex flex-col gap-8">

    <p class="text-2xl font-medium text-[var(--text-light)]">Sketching Tools</p>

    <div class="flex flex-wrap gap-y-7 gap-x-14">
      <div class="flex flex-col gap-2">
        <p class="text-md font-medium text-[var(--text-light)] mb-1">Navigate</p>
        <a href={`${base}/`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Home</a>
        <a href={`${base}/tools/warmup`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Warmup</a>
        <a href={`${base}/tools/drafts`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Sketchbook</a>
        <a href={`${base}/settings`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Réglages</a>
      </div>
      <div class="flex flex-col gap-2">
        <p class="text-md font-medium text-[var(--text-light)] mb-1">Design</p>
        <a href={`${base}/style`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Style</a>
        <a href={`${base}/components`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Components</a>
      </div>
      <div class="flex flex-col gap-2">
        <p class="text-md font-medium text-[var(--text-light)] mb-1">Legal</p>
        <a href={`${base}/legal/terms-and-conditions`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Terms and conditions</a>
        <a href={`${base}/legal/privacy-policy`} class="text-sm font-light text-[var(--text-light)] no-underline opacity-70 [transition:opacity_150ms_ease] hover:opacity-100">Privacy Policy</a>
      </div>
    </div>

    <div class="h-px bg-[var(--color-gray-800)]"></div>

    <div class="flex flex-wrap justify-between items-start gap-y-2 gap-x-6">
      <p class="text-xs font-light text-[var(--text-light-subdue)]">© {year} Sketching Tools. All rights reserved.</p>
      <p class="text-xs font-light text-[var(--text-light)]"><span class="font-thin text-[var(--text-light-subdue)]">By</span> <a href="https://malogermond.com" class="text-[var(--text-light)] no-underline [transition:opacity_150ms_ease] hover:opacity-70" target="_blank" rel="noopener">Malo Germond</a></p>
    </div>

  </div>
</footer>
