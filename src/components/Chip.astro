---
import Pill from './Pill.astro';

interface Props {
  value: string | number;
  unit?: string;
  color?: 'success' | 'error' | 'warning';
}

const { value, unit, color = 'success' } = Astro.props;
---

<div class="chip">
  <Pill color={color} />
  <span class="chip-value">{value}</span>
  {unit && <span class="chip-unit">{unit}</span>}
</div>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--surface-subdue);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .chip-value {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: var(--font-weight-default);
    color: var(--text-default);
    line-height: 1;
  }

  .chip-unit {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: var(--font-weight-default);
    color: var(--text-subdue);
    line-height: 1;
  }
</style>
