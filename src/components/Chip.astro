---
import Pill from './Pill.astro';

interface Props {
  value: string | number;
  unit?: string;
  color?: 'success' | 'error' | 'warning';
}

const { value, unit, color = 'success' } = Astro.props;
---

<div class="inline-flex items-center gap-2 py-1.5 px-3 bg-[var(--surface-subdue)] border border-[var(--border-default)] rounded-full whitespace-nowrap">
  <Pill color={color} />
  <span class="font-sans text-lg font-[var(--font-weight-default)] text-[var(--text-default)] leading-none">{value}</span>
  {unit && <span class="font-sans text-lg font-[var(--font-weight-default)] text-[var(--text-subdue)] leading-none">{unit}</span>}
</div>
