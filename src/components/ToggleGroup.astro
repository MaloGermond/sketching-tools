---
/**
 * Composant ToggleGroup - Groupe de boutons toggle avec sélection unique
 * 
 * @description
 * Un conteneur pour des boutons Toggle qui gère la sélection unique.
 * Quand un toggle est sélectionné, les autres sont désélectionnés.
 * Agnostique : la logique de gestion des toggle est encapsulée ici.
 * 
 * @props
 * @prop {string[]} icons - Liste des noms d'icônes à afficher
 * @prop {string} [selectedIcon] - Icône actuellement sélectionnée
 * @prop {string} [groupId] - ID du groupe pour l'élément DOM (défaut: 'toggle-group')
 */

import Toggle from './Toggle.astro';

interface Props {
  icons: string[];
  selectedIcon?: string;
  groupId?: string;
}

const { icons, selectedIcon = '', groupId = 'toggle-group' } = Astro.props;
---

<div id={groupId} class="flex gap-2">
  {
    icons.map((icon) => (
      <Toggle 
        icon={icon} 
        selected={icon === selectedIcon}
      />
    ))
  }
</div>

<script>
  // Gérer les clics sur les Toggle du groupe
  document.addEventListener('DOMContentLoaded', () => {
    const group = document.getElementById({groupId});
    if (!group) return;

    // Sélectionner le toggle correspondant à selectedIcon au chargement
    if (selectedIcon) {
      const selectedToggle = group.querySelector(`.toggle-button[data-icon="${selectedIcon}"]`);
      if (selectedToggle) {
        selectedToggle.dataset.selected = 'true';
      }
    }

    // Gérer les clics
    group.addEventListener('click', (event) => {
      const toggle = event.target.closest('.toggle-button');
      if (!toggle) return;

      const icon = toggle.dataset.icon;
      if (!icon) return;

      // Si déjà sélectionné, ne rien faire (ou désélectionner selon le besoin)
      const isSelected = toggle.dataset.selected === 'true';
      
      // Désélectionner tous les toggles
      group.querySelectorAll('.toggle-button').forEach(btn => {
        btn.dataset.selected = 'false';
      });

      // Sélectionner le toggle cliqué (sauf si déjà sélectionné)
      if (!isSelected) {
        toggle.dataset.selected = 'true';
        
        // Dispatcher un événement avec l'icône sélectionnée
        document.dispatchEvent(new CustomEvent('toggleGroupSelected', {
          detail: { icon: icon }
        }));
      }
    });
  });
</script>
