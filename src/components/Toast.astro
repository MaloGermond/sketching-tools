---
interface Props {
  toastId: string;
  label?: string;
}

const { toastId, label = 'Score' } = Astro.props;
---

<div
  id={toastId}
  data-toast-id={toastId}
  class="toast-wrapper"
>
  <div class="toast-pill">
    <span id={toastId + '-dot'} class="toast-dot"></span>
    <div class="toast-content">
      <p class="toast-label">{label}</p>
      <p id={toastId + '-value'} class="toast-value"></p>
    </div>
  </div>
</div>

<style>
  .toast-wrapper {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease, top 300ms ease;
  }

  .toast-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    border-radius: 9999px;
    padding: 0 1.25rem;
    height: 50px;
    min-width: 114px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.10), 0 1px 4px rgb(0 0 0 / 0.06);
    border: 1px solid var(--color-gray-200);
  }

  .toast-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    transition: background 200ms ease;
  }

  .toast-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .toast-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-gray-500);
    line-height: 1;
    margin-bottom: 0.125rem;
  }

  .toast-value {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-gray-900);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const duration = 1800;
    let currentTimeout = null;

    const toastEl = document.querySelector('[data-toast-id]');
    if (!toastEl) return;

    const toastId = toastEl.dataset.toastId;
    const valueEl = document.getElementById(toastId + '-value');
    const dotEl = document.getElementById(toastId + '-dot');

    if (!valueEl || !dotEl) return;

    document.addEventListener('showToast', (event) => {
      const score = event.detail?.score;
      if (score === undefined) return;

      if (currentTimeout) clearTimeout(currentTimeout);

      const color =
        score >= 80 ? '#22c55e' :
        score >= 50 ? '#f59e0b' :
        '#ef4444';

      valueEl.textContent = `${Math.floor(score)}%`;
      valueEl.style.color = color;
      dotEl.style.background = color;

      toastEl.style.top = '-80px';
      toastEl.style.opacity = '0';

      void toastEl.offsetHeight;

      requestAnimationFrame(() => {
        toastEl.style.top = '1rem';
        toastEl.style.opacity = '1';
      });

      currentTimeout = setTimeout(() => {
        toastEl.style.top = '-80px';
        toastEl.style.opacity = '0';
      }, duration);
    });
  });
</script>
