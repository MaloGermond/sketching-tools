---
import Chip from './Chip.astro';

interface Props {
  toastId: string;
  label?: string;
}

const { toastId, label = 'Score' } = Astro.props;
---

<div
  id={toastId}
  data-toast-id={toastId}
  class="toast-wrapper"
>
  <div class="toast-chip">
    <span id={toastId + '-dot'} class="toast-dot"></span>
    <div class="toast-text">
      <p class="toast-label">{label}</p>
      <p id={toastId + '-value'} class="toast-value"></p>
    </div>
  </div>
</div>

<style>
  .toast-wrapper {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease, top 300ms ease;
  }

  .toast-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px 6px 12px;
    background: var(--color-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-float);
    white-space: nowrap;
  }

  .toast-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--text-success);
    flex-shrink: 0;
    transition: background 200ms ease;
  }

  .toast-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .toast-label {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-default);
    color: var(--text-subdue);
    line-height: 1;
  }

  .toast-value {
    font-size: 1.125rem;
    font-weight: var(--font-weight-default);
    color: var(--text-default);
    line-height: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const duration = 1800;
    let currentTimeout = null;

    const toastEl = document.querySelector('[data-toast-id]');
    if (!toastEl) return;

    const toastId = toastEl.dataset.toastId;
    const valueEl = document.getElementById(toastId + '-value');
    const dotEl = document.getElementById(toastId + '-dot');

    if (!valueEl || !dotEl) return;

    document.addEventListener('showToast', (event) => {
      const score = event.detail?.score;
      if (score === undefined) return;

      if (currentTimeout) clearTimeout(currentTimeout);

      const style = getComputedStyle(document.documentElement);
      const color =
        score >= 80 ? style.getPropertyValue('--text-success').trim() :
        score >= 50 ? style.getPropertyValue('--text-warning').trim() :
        style.getPropertyValue('--text-error').trim();

      valueEl.textContent = `${Math.floor(score)}%`;
      dotEl.style.background = color;

      toastEl.style.top = '-80px';
      toastEl.style.opacity = '0';
      void toastEl.offsetHeight;

      requestAnimationFrame(() => {
        toastEl.style.top = '1rem';
        toastEl.style.opacity = '1';
      });

      currentTimeout = setTimeout(() => {
        toastEl.style.top = '-80px';
        toastEl.style.opacity = '0';
      }, duration);
    });
  });
</script>
