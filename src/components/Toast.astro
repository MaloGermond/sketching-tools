---
// Toast.astro - Composant de notification toast
// Affiche un message temporaire avec animation

interface Props {
  id?: string;
  duration?: number;
}

const { id = 'toast', duration = 2000 } = Astro.props;
---

<div
  id={id}
  style="position: fixed; top: -100px; left: 50%; transform: translateX(-50%); z-index: 50; pointer-events: none; opacity: 0; transition: top 0.3s ease-out, opacity 0.3s ease-out;"
>
  <div style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem; background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); border: 1px solid #e5e7eb; padding: 0.75rem 1.5rem; min-width: 200px;">
    <span style="font-size: 0.875rem; font-weight: 500; color: #374151; letter-spacing: 0.05em; text-transform: uppercase;">Ressemblance</span>
    <span id="{id}-value" style="font-size: 1.5rem; font-weight: 700; line-height: 1; color: #8b5cf6;"></span>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let isAnimating = false;
    let currentTimeout = null;
    const toastEl = document.getElementById('{id}');
    const valueEl = document.getElementById('{id}-value');
    
    if (!toastEl || !valueEl) return;

    // Écouter l'événement personnalisé depuis n'importe quel composant
    document.addEventListener('showToast', (event) => {
      const score = event.detail?.score;
      if (score === undefined) return;
      
      // Clear previous timeout
      if (currentTimeout) {
        clearTimeout(currentTimeout);
      }
      
      // Set color based on score
      const color = score >= 80 
        ? '#8b5cf6'  // purple-600
        : score >= 50 
          ? '#f59e0b'  // amber-500
          : '#ef4444'; // red-500
      
      valueEl.textContent = `${Math.floor(score)}%`;
      valueEl.style.color = color;
      
      // If already animating, reset quickly
      if (isAnimating) {
        toastEl.style.top = '-100px';
        toastEl.style.opacity = '0';
        
        setTimeout(() => {
          startAnimation(toastEl);
        }, 100);
      } else {
        startAnimation(toastEl);
      }
    });

    function startAnimation(element) {
      isAnimating = true;
      
      // Reset position
      element.style.top = '-100px';
      element.style.opacity = '0';
      element.style.transition = 'top 0.3s ease-out, opacity 0.3s ease-out';
      
      // Force reflow
      void element.offsetHeight;
      
      // Start animation
      setTimeout(() => {
        element.style.top = '0.5rem';
        element.style.opacity = '1';
      }, 10);
      
      // Hide after duration
      currentTimeout = setTimeout(() => {
        element.style.transition = 'top 0.2s ease-in, opacity 0.2s ease-in';
        element.style.top = '-100px';
        element.style.opacity = '0';
        
        setTimeout(() => {
          element.style.transition = 'top 0.3s ease-out, opacity 0.3s ease-out';
          isAnimating = false;
        }, 200);
      }, duration);
    }
  });
</script>
