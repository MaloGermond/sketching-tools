---
interface Props {
  toastId: string;
}

const { toastId } = Astro.props;
---

<div id={toastId} data-toast-id={toastId} class="toast-wrapper">
  <div class="toast-chip">
    <span id={toastId + '-dot'} class="toast-dot"></span>
    <div class="toast-text">
      <p id={toastId + '-value'} class="toast-value"></p>
      <p class="toast-unit">%</p>
    </div>
  </div>
</div>

<style>
  .toast-wrapper {
    position: fixed;
    top: 1rem;
    left: 50%;
    z-index: 50;
    pointer-events: none;
    transform: translateX(-50%) translateY(calc(-100% - 2rem));
    opacity: 0;
    transition: transform 200ms ease-in, opacity 200ms ease-in;
  }

  .toast-wrapper.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    transition: transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 250ms ease-out;
  }

  .toast-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--color-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-float);
    white-space: nowrap;
  }

  .toast-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--text-success);
    flex-shrink: 0;
    transition: background 200ms ease;
  }

  .toast-text {
    display: flex;
    flex-direction: row;
    gap: 1px;
    align-items: baseline;
  }

  .toast-value {
    font-size: 1.125rem;
    font-weight: var(--font-weight-default);
    color: var(--text-default);
    line-height: 1;
  }

  .toast-unit {
    font-size: 1.125rem;
    font-weight: var(--font-weight-subdue);
    color: var(--text-subdue);
    line-height: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const DURATION = 1800;
    const EXIT_DURATION = 220;

    const toastEl = document.querySelector('[data-toast-id]');
    if (!toastEl) return;

    const toastId = toastEl.dataset.toastId;
    const valueEl = document.getElementById(toastId + '-value');
    const dotEl = document.getElementById(toastId + '-dot');

    if (!valueEl || !dotEl) return;

    let hideTimeout = null;

    /** @pure */
    const getScoreColor = (score) => {
      const style = getComputedStyle(document.documentElement);
      if (score >= 80) return style.getPropertyValue('--text-success').trim();
      if (score >= 50) return style.getPropertyValue('--text-warning').trim();
      return style.getPropertyValue('--text-error').trim();
    };

    /** @impure — side effect: modifie le DOM */
    const updateContent = (score) => {
      valueEl.textContent = `${Math.floor(score)}`;
      dotEl.style.background = getScoreColor(score);
    };

    /** @impure — side effect: retire la classe is-visible */
    const hide = () => toastEl.classList.remove('is-visible');

    /** @impure — side effect: anime le toast, schedule un timeout */
    const show = (score) => {
      if (hideTimeout) clearTimeout(hideTimeout);

      const isVisible = toastEl.classList.contains('is-visible');

      if (isVisible) {
        hide();
        setTimeout(() => {
          updateContent(score);
          requestAnimationFrame(() => toastEl.classList.add('is-visible'));
          hideTimeout = setTimeout(hide, DURATION);
        }, EXIT_DURATION);
        return;
      }

      updateContent(score);
      requestAnimationFrame(() => toastEl.classList.add('is-visible'));
      hideTimeout = setTimeout(hide, DURATION);
    };

    document.addEventListener('showToast', (event) => {
      const score = event.detail?.score;
      if (score !== undefined) show(score);
    });
  });
</script>
