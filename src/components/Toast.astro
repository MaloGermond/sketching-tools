---
// Toast.astro - Composant de notification toast réutilisable
// Affiche un message temporaire avec animation

interface Props {
  toastId: string;
  label?: string;
}

const { toastId, label = 'Score' } = Astro.props;
---

<div
  id={toastId}
  data-toast-id={toastId}
  class="fixed top-4 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-all duration-300 ease-out"
>
  <div class="flex flex-col items-center bg-white rounded-full shadow-md border border-gray-200 px-6 pt-3 pb-2">
    <p class="text-xs font-medium text-gray-600">{label}</p>
    <p id={toastId + '-value'} class="text-md font-bold leading-none text-purple-600"></p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const duration = 2000;
    let isAnimating = false;
    let currentTimeout = null;
    
    // Trouver le toast via son data attribute
    const toastContainer = document.querySelector('[data-toast-id]');
    if (!toastContainer) return;
    
    const toastId = toastContainer.dataset.toastId;
    const toastEl = document.getElementById(toastId);
    const valueEl = document.getElementById(toastId + '-value');
    
    if (!toastEl || !valueEl) return;

    // Écouter l'événement personnalisé
    document.addEventListener('showToast', (event) => {
      const score = event.detail?.score;
      if (score === undefined) return;
      
      // Clear previous timeout
      if (currentTimeout) {
        clearTimeout(currentTimeout);
      }
      
      // Set color based on score: success (>=80), warning (>=50), error (<50)
      // Utilisation des classes définies dans typography.css
      const colorClass = score >= 80 
        ? 'text-success'   // success: var(--color-success)
        : score >= 50 
          ? 'text-warning'  // warning: var(--color-warning)
          : 'text-error';   // error: var(--color-error)
      
      valueEl.textContent = `${Math.floor(score)}%`;
      valueEl.className = `text-xl font-bold leading-none ${colorClass}`;
      
      // If already animating, reset quickly
      if (isAnimating) {
        toastEl.style.top = '-100px';
        toastEl.style.opacity = '0';
        
        setTimeout(() => {
          startAnimation(toastEl);
        }, 100);
      } else {
        startAnimation(toastEl);
      }
    });

    function startAnimation(element) {
      isAnimating = true;
      
      // Reset position
      element.style.top = '-100px';
      element.style.opacity = '0';
      
      // Force reflow
      void element.offsetHeight;
      
      // Start animation
      setTimeout(() => {
        element.style.top = '1rem';
        element.style.opacity = '1';
      }, 10);
      
      // Hide after fixed duration
      currentTimeout = setTimeout(() => {
        element.style.transition = 'top 0.2s ease-in, opacity 0.2s ease-in';
        element.style.top = '-100px';
        element.style.opacity = '0';
        
        setTimeout(() => {
          element.style.transition = 'top 0.3s ease-out, opacity 0.3s ease-out';
          isAnimating = false;
        }, 200);
      }, duration);
    }
  });
</script>
