---
interface Props {
  color?: 'success' | 'error' | 'warning';
  size?: number;
}

const { color = 'success', size = 16 } = Astro.props;

const colorMap: Record<string, string> = {
  success: '#22C55E',
  error:   '#EF4444',
  warning: '#FACC15',
};

const bg = colorMap[color] ?? colorMap.success;
---

<span
  class="pill"
  style={`width: ${size}px; height: ${size}px; background: ${bg};`}
  aria-label={color}
/>

<style>
  .pill {
    display: inline-block;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
