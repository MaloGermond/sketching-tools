---
/**
 * Composant Toggle - Bouton bascule avec icône
 * 
 * @description
 * Un bouton carré avec icône seule qui bascule entre l'état default et primary.
 * 
 * @props
 * @prop {string} icon - Nom de l'icône SVG à afficher (correspond au fichier dans public/icons/)
 * @prop {boolean} [selected] - État sélectionné initial (défaut: false)
 * @prop {number} [size] - Taille du bouton en pixels (défaut: 48)
 * @prop {string} [onClick] - Callback JavaScript supplémentaire à exécuter au clic
 */

import Icon from './Icon.astro';

interface Props {
  icon: string;
  selected?: boolean;
  size?: number;
  onClick?: string;
}

const {
  icon,
  selected = false,
  size = 48,
  onClick
} = Astro.props;

const toggleClick = onClick || "";
---

<button
  type="button"
  class="toggle-button"
  data-selected={selected}
  data-icon={icon}
  style={{
    '--toggle-size': `${size}px`,
    width: 'var(--toggle-size)',
    height: 'var(--toggle-size)',
    padding: '0',
    border: 'none',
    borderRadius: 'var(--radius-md)',
    cursor: 'pointer',
    display: 'inline-flex',
    alignItems: 'center',
    justifyContent: 'center'
  }}
  onclick={toggleClick}
>
  <Icon name={icon} size={size * 0.5} />
</button>

<style>
  .toggle-button {
    --toggle-bg-enable: transparent;
    --toggle-bg-hover: var(--color-gray-300);
    --toggle-bg-selected: var(--color-accent);
    
    background: var(--toggle-bg-enable);
    transition: background 400ms ease;
  }
  
  .toggle-button:hover:not([data-selected="true"]) {
    background: var(--toggle-bg-hover);
  }
  
  .toggle-button[data-selected="true"] {
    background: var(--toggle-bg-selected);
  }
</style>
