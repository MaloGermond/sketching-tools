---
import Icon from './Icon.astro';

interface Props {
  variant?: 'emphasis' | 'primary' | 'default' | 'facultatif';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconSize?: number;
  onClick?: string;
  href?: string;
}

const {
  variant = 'default',
  size = 'md',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'left',
  iconSize = 14,
  onClick,
  href
} = Astro.props;

const isLink = !!href;

const classes = [
  'action',
  `action--${variant}`,
  `action--${size}`,
  fullWidth ? 'action--full' : '',
  disabled ? 'action--disabled' : '',
].filter(Boolean).join(' ');
---

{isLink ? (
  <a
    href={href}
    aria-disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </a>
) : (
  <button
    type="button"
    disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </button>
)}

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
    -webkit-font-smoothing: antialiased;
  }

  .action:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }

  .action--disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .action--full { width: 100%; }

  /* ─── Sizes ─── */
  .action--sm { padding: 0.375rem 0.625rem; font-size: 0.8125rem; }
  .action--md { padding: 0.5rem 0.875rem; }
  .action--lg { padding: 0.625rem 1.125rem; font-size: 0.9375rem; gap: 0.5rem; }

  /* ─── Emphasis — noir ─── */
  .action--emphasis {
    background-color: #111827;
    color: #ffffff;
    border-color: #111827;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  .action--emphasis:hover { background-color: #1f2937; border-color: #1f2937; }
  .action--emphasis:active { background-color: #374151; box-shadow: none; }

  /* ─── Primary — bleu ─── */
  .action--primary {
    background-color: #2563EB;
    color: #ffffff;
    border-color: #2563EB;
    box-shadow: 0 1px 2px rgb(37 99 235 / 0.25);
  }
  .action--primary:hover { background-color: #1D4ED8; border-color: #1D4ED8; }
  .action--primary:active { box-shadow: none; filter: brightness(0.96); }

  /* ─── Default — blanc + bordure ─── */
  .action--default {
    background-color: #ffffff;
    color: #111827;
    border-color: #BFCBD6;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
  .action--default:hover { background-color: #f9fafb; border-color: #9ca3af; }
  .action--default:active { background-color: #f2f4f6; box-shadow: none; }

  /* ─── Facultatif — ghost ─── */
  .action--facultatif {
    background-color: transparent;
    color: #6F859C;
    border-color: transparent;
  }
  .action--facultatif:hover { background-color: #f2f4f6; color: #111827; }
  .action--facultatif:active { background-color: #e4e7eb; }
</style>
