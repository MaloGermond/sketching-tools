---
import Icon from './Icon.astro';

interface Props {
  variant?: 'emphasis' | 'primary' | 'default' | 'facultatif';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconSize?: number;
  onClick?: string;
  href?: string;
}

const {
  variant = 'default',
  size = 'md',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'left',
  iconSize = 14,
  onClick,
  href
} = Astro.props;

const isLink = !!href;

const classes = [
  'action',
  `action--${variant}`,
  `action--${size}`,
  fullWidth ? 'action--full' : '',
  disabled ? 'action--disabled' : '',
].filter(Boolean).join(' ');
---

{isLink ? (
  <a
    href={href}
    aria-disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </a>
) : (
  <button
    type="button"
    disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </button>
)}

<style>
  /* ─── Base ─────────────────────────────────────── */
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 120ms ease, box-shadow 120ms ease, color 120ms ease;
    /* Focus ring — Tailwind UI style */
    outline: none;
  }

  .action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .action--disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }

  .action--full { width: 100%; }

  /* ─── Sizes ─────────────────────────────────────── */
  .action--sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    gap: 0.3rem;
  }

  .action--md {
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
  }

  .action--lg {
    padding: 0.625rem 1.125rem;
    font-size: 0.9375rem;
    gap: 0.5rem;
  }

  /* ─── Emphasis — dark filled ─────────────────────── */
  .action--emphasis {
    background-color: var(--color-gray-900);
    color: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
  }
  .action--emphasis:hover {
    background-color: var(--color-gray-800);
  }
  .action--emphasis:active {
    background-color: var(--color-gray-700);
    box-shadow: none;
  }

  /* ─── Primary — accent filled ───────────────────── */
  .action--primary {
    background-color: var(--color-accent);
    color: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  .action--primary:hover {
    background-color: var(--color-accent-hover);
  }
  .action--primary:active {
    box-shadow: none;
    filter: brightness(0.95);
  }

  /* ─── Default — white + ring (Tailwind UI style) ── */
  .action--default {
    background-color: #fff;
    color: var(--color-gray-900);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      inset 0 0 0 1px var(--color-gray-300);
  }
  .action--default:hover {
    background-color: var(--color-gray-50);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      inset 0 0 0 1px var(--color-gray-300);
  }
  .action--default:active {
    background-color: var(--color-gray-100);
    box-shadow: inset 0 0 0 1px var(--color-gray-300);
  }

  /* ─── Facultatif — ghost ────────────────────────── */
  .action--facultatif {
    background-color: transparent;
    color: var(--color-gray-600);
    box-shadow: none;
  }
  .action--facultatif:hover {
    background-color: var(--color-gray-100);
    color: var(--color-gray-900);
  }
  .action--facultatif:active {
    background-color: var(--color-gray-200);
  }
</style>
