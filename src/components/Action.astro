---
import Icon from './Icon.astro';

interface Props {
  variant?: 'emphasis' | 'primary' | 'default' | 'facultatif' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconSize?: number;
  onClick?: string;
  href?: string;
}

const {
  variant = 'default',
  size = 'md',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'left',
  iconSize = 14,
  onClick,
  href
} = Astro.props;

const isLink = !!href;

const classes = [
  'action',
  `action--${variant}`,
  `action--${size}`,
  fullWidth ? 'action--full' : '',
  disabled ? 'action--disabled' : '',
].filter(Boolean).join(' ');
---

{isLink ? (
  <a
    href={href}
    aria-disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </a>
) : (
  <button
    type="button"
    disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </button>
)}

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
    -webkit-font-smoothing: antialiased;
  }

  .action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .action--disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .action--full { width: 100%; }

  /* ─── Sizes ─── */
  .action--sm { padding: 0.375rem 0.625rem; font-size: var(--text-sm); }
  .action--md { padding: 0.5rem 0.875rem; }
  .action--lg { padding: 0.625rem 1.125rem; font-size: 0.9375rem; gap: 0.5rem; }

  /* ─── Emphasis — contraste maximal, s'inverse avec le thème ─── */
  .action--emphasis {
    background-color: var(--text-default);
    color: var(--background);
    border-color: var(--text-default);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  .action--emphasis:hover { filter: brightness(1.15); }
  .action--emphasis:active { filter: brightness(1.3); box-shadow: none; }

  /* ─── Primary — bleu d'accent, constant dans les deux thèmes ─── */
  .action--primary {
    background-color: var(--color-accent);
    color: var(--color-white);
    border-color: var(--color-accent);
    box-shadow: 0 1px 2px rgb(37 99 235 / 0.25);
  }
  .action--primary:hover { background-color: var(--color-accent-hover); border-color: var(--color-accent-hover); }
  .action--primary:active { box-shadow: none; filter: brightness(0.96); }

  /* ─── Default — surface + bordure, s'adapte au thème ─── */
  .action--default {
    background-color: var(--surface-raised);
    color: var(--text-default);
    border-color: var(--border-default);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
  .action--default:hover { background-color: var(--surface-subdue); }
  .action--default:active { background-color: var(--surface-default); box-shadow: none; }

  /* ─── Facultatif — ghost ─── */
  .action--facultatif {
    background-color: transparent;
    color: var(--text-subdue);
    border-color: transparent;
  }
  .action--facultatif:hover { background-color: var(--surface-subdue); color: var(--text-default); }
  .action--facultatif:active { background-color: var(--surface-default); }

  /* ─── Danger — rouge, constant dans les deux thèmes ─── */
  .action--danger {
    background-color: var(--color-red-500);
    color: var(--color-white);
    border-color: var(--color-red-500);
    box-shadow: 0 1px 2px rgb(239 68 68 / 0.25);
  }
  .action--danger:hover { background-color: var(--color-red-600); border-color: var(--color-red-600); }
  .action--danger:active { box-shadow: none; filter: brightness(0.96); }
</style>
