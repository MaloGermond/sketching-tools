---
import Icon from './Icon.astro';

interface Props {
  variant?: 'emphasis' | 'primary' | 'default' | 'facultatif' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconSize?: number;
  onClick?: string;
  href?: string;
}

const {
  variant = 'default',
  size = 'md',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'left',
  iconSize = 14,
  onClick,
  href
} = Astro.props;

const isLink = !!href;

const baseClasses = "inline-flex items-center justify-center gap-1.5 font-sans font-semibold text-sm leading-tight rounded-sm border border-transparent cursor-pointer no-underline whitespace-nowrap [transition:background-color_120ms_ease,border-color_120ms_ease,color_120ms_ease,box-shadow_120ms_ease] antialiased focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-2";

const sizeClasses: Record<string, string> = {
  sm: 'py-1.5 px-2.5 text-sm',
  md: 'py-2 px-3.5',
  lg: 'py-2.5 px-[1.125rem] text-[0.9375rem] gap-2',
};

const variantClasses: Record<string, string> = {
  emphasis: 'bg-[var(--text-default)] text-[var(--background)] border-[var(--text-default)] shadow-[0_1px_2px_rgb(0_0_0_/_0.15)] hover:brightness-[1.15] active:brightness-[1.3] active:shadow-none',
  primary: 'bg-[var(--color-accent)] text-white border-[var(--color-accent)] shadow-[0_1px_2px_rgb(37_99_235_/_0.25)] hover:bg-[var(--color-accent-hover)] hover:border-[var(--color-accent-hover)] active:shadow-none active:brightness-[0.96]',
  default: 'bg-[var(--surface-raised)] text-[var(--text-default)] border-[var(--border-default)] shadow-[0_1px_2px_rgb(0_0_0_/_0.06)] hover:bg-[var(--surface-subdue)] active:bg-[var(--surface-default)] active:shadow-none',
  facultatif: 'bg-transparent text-[var(--text-subdue)] border-transparent hover:bg-[var(--surface-subdue)] hover:text-[var(--text-default)] active:bg-[var(--surface-default)]',
  danger: 'bg-[var(--color-red-500)] text-white border-[var(--color-red-500)] shadow-[0_1px_2px_rgb(239_68_68_/_0.25)] hover:bg-[var(--color-red-600)] hover:border-[var(--color-red-600)] active:shadow-none active:brightness-[0.96]',
};

const classes = [
  baseClasses,
  variantClasses[variant] ?? variantClasses.default,
  sizeClasses[size] ?? sizeClasses.md,
  fullWidth ? 'w-full' : '',
  disabled ? 'opacity-40 pointer-events-none' : '',
].filter(Boolean).join(' ');
---

{isLink ? (
  <a
    href={href}
    aria-disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </a>
) : (
  <button
    type="button"
    disabled={disabled}
    class={classes}
    {...(onClick && { onclick: onClick })}
  >
    {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
  </button>
)}
