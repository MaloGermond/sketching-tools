---
/**
 * Composant Action - Bouton réutilisable pour l'application Sketching Tools
 * 
 * @description
 * Un composant de bouton flexible avec plusieurs variantes et tailles.
 * 
 * @variants
 * - emphasis: Action principale à mettre en avant (fond noir, texte blanc)
 * - primary: Action ponctuelle pour focaliser l'attention (fond --color-accent, texte blanc)
 * - default: Action standard (fond gris, texte noir)
 * - facultatif: Action secondaire ou optionnelle (fond transparent, texte noir)
 * 
 * @sizes
 * - sm: Petit
 * - md: Moyen (défaut)
 * - lg: Grand
 * 
 * @props
 * @prop {('emphasis' | 'primary' | 'default' | 'facultatif')} variant - Variante du bouton (défaut: 'default')
 * @prop {('sm' | 'md' | 'lg')} size - Taille du bouton (défaut: 'md')
 * @prop {boolean} disabled - Désactive le bouton (défaut: false)
 * @prop {boolean} fullWidth - Bouton en pleine largeur (défaut: false)
 * @prop {string} [icon] - Nom de l'icône SVG à afficher (optionnel, correspond au fichier dans public/icons/)
 * @prop {('left' | 'right')} iconPosition - Position de l'icône (défaut: 'left')
 * @prop {number} [iconSize] - Taille de l'icône en pixels (défaut: 20)
 * @prop {string} [onClick] - Callback JavaScript à exécuter au clic (ex: "showToast({ score: 95 })")
 */

import Icon from './Icon.astro';

interface Props {
  variant?: 'emphasis' | 'primary' | 'default' | 'facultatif';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  iconSize?: number;
  onClick?: string;
}

const {
  variant = 'default',
  size = 'md',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'left',
  iconSize = 20,
  onClick
} = Astro.props;

// Styles dynamiques en fonction des props
const getVariantStyles = () => {
  switch (variant) {
    case 'emphasis':
      return {
        background: 'var(--color-black)',
        color: 'var(--color-white)',
        hover: 'var(--color-gray-900)',
        active: 'var(--color-gray-700)'
      };
    case 'primary':
      return {
        background: 'var(--color-accent)',
        color: 'var(--color-white)',
        hover: '#7c3aed', // Purple-700
        active: '#6d28d9' // Purple-800
      };
    case 'default':
      return {
        background: 'var(--color-gray-200)',
        color: 'var(--color-black)',
        hover: 'var(--color-gray-400)',
        active: 'var(--color-gray-700)'
      };
    case 'facultatif':
      return {
        background: 'transparent',
        color: 'var(--color-black)',
        border: '1px solid var(--color-gray-300)',
        hover: 'var(--color-gray-100)',
        active: 'var(--color-gray-200)'
      };
    default:
      return {
        background: 'var(--color-gray-200)',
        color: 'var(--color-black)',
        hover: 'var(--color-gray-400)',
        active: 'var(--color-gray-700)'
      };
  }
};

const styles = getVariantStyles();

// Tailles
const getSizeStyles = () => {
  switch (size) {
    case 'sm':
      return {
        padding: 'var(--space-xs) var(--space-sm)',
        fontSize: 'var(--font-size-sm)'
      };
    case 'md':
      return {
        padding: 'var(--space-sm) var(--space-md)',
        fontSize: 'var(--font-size-base)'
      };
    case 'lg':
      return {
        padding: 'var(--space-md) var(--space-lg)',
        fontSize: 'var(--font-size-lg)'
      };
    default:
      return {
        padding: 'var(--space-sm) var(--space-md)',
        fontSize: 'var(--font-size-base)'
      };
  }
};

const sizeStyles = getSizeStyles();
---

<!-- Composant Bouton -->
<button
  type="button"
  disabled={disabled}
  aria-disabled={disabled}
  data-variant={variant}
  {...(onClick && { onclick: onClick })}
  class:list={[
    'action-button',
    `variant-${variant}`,
    `size-${size}`,
    { 'full-width': fullWidth },
    { 'disabled': disabled }
  ]}
  style={{
    background: styles.background,
    color: styles.color,
    padding: sizeStyles.padding,
    fontSize: sizeStyles.fontSize,
    width: fullWidth ? '100%' : 'auto',
    border: variant === 'facultatif' ? styles.border : 'none',
    cursor: disabled ? 'not-allowed' : 'pointer',
    opacity: disabled ? 0.5 : 1,
    transition: 'all var(--transition-fast)',
    borderRadius: 'var(--radius-md)',
    fontFamily: 'var(--font-family)',
    fontWeight: 'var(--font-weight-medium)',
    display: 'inline-flex',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 'var(--space-sm)',
    textDecoration: 'none'
  }}
  {...(disabled && { 'aria-disabled': 'true' })}
  data-hover={styles.hover}
  data-active={styles.active}
>
  {icon && iconPosition === 'left' && <Icon name={icon} size={iconSize} />}
  <slot />
  {icon && iconPosition === 'right' && <Icon name={icon} size={iconSize} />}
</button>

<style>
  .action-button {
    --transition-fast: 150ms ease;
  }
  
  .action-button:hover:not(:disabled) {
    background: var(--hover-bg, var(--color-gray-300));
  }
  
  .action-button:active:not(:disabled) {
    background: var(--active-bg, var(--color-gray-400));
  }
  
  .action-button:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  
  .action-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  
  .action-button.full-width {
    width: 100%;
  }
  
</style>

<script is:inline>
  // Set CSS variables for hover/active states
  const buttons = document.querySelectorAll('.action-button');
  buttons.forEach(button => {
    button.style.setProperty('--hover-bg', button.dataset.hover);
    button.style.setProperty('--active-bg', button.dataset.active);
  });
</script>
