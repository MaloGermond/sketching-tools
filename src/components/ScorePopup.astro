---
// ScorePopup.astro - Composant d'affichage du score temporaire
// Affiche uniquement le score (l'image est maintenant dans Scoreboard)
// Utilisation : <ScorePopup client:load />
---

<div
  id="score-popup"
  class="score-popup"
  style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 20; pointer-events: none; opacity: 0; transition: opacity 0.3s ease;"
>
  <span id="score-value" class="score-text score-text-lg"></span>
</div>

<style>
  .score-popup {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .score-text {
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }
  
  .score-text-lg {
    font-size: 3rem;
  }
</style>

<script>
  // Fonction globale pour afficher le score (sans image)
  window.showTemporaryScore = function(score) {
    const popupEl = document.getElementById('score-popup');
    const valueEl = document.getElementById('score-value');
    
    if (!popupEl || !valueEl) return;
    
    // Effacer le timeout précédent
    if (window.scoreTimeout) {
      clearTimeout(window.scoreTimeout);
    }
    
    // Déterminer la couleur selon le score
    const color = score >= 80 
      ? 'var(--color-accent)' 
      : score >= 50 
        ? '#f59e0b' 
        : '#ef4444';
    
    valueEl.textContent = `${Math.floor(score)}%`;
    valueEl.style.color = color;
    popupEl.style.opacity = '1';
    
    // Cacher après 2 secondes
    window.scoreTimeout = setTimeout(() => {
      popupEl.style.opacity = '0';
    }, 2000);
  };
</script>
