---
interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;
---

<div class="flex flex-col items-stretch sm:flex-row sm:items-center justify-between gap-6 p-5 bg-[var(--surface-subdue)] border border-[var(--border-default)] rounded-lg">
  <div class="flex flex-col gap-1 min-w-0">
    <p class="text-md font-semibold text-[var(--text-default)]">{heading}</p>
    <p class="text-sm text-[var(--text-subdue)] leading-snug">{description}</p>
  </div>
  <div class="shrink-0">
    <slot />
  </div>
</div>
