---
import Card from './Card.astro';

interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;
---

<Card
  background="bg-[var(--surface-subdue)]"
  border="border-[var(--border-default)]"
  radius="rounded-lg"
  padding="p-5"
  class="flex flex-col items-stretch sm:flex-row sm:items-center justify-between gap-6"
>
  <div class="flex flex-col gap-1 min-w-0">
    <p class="text-md font-semibold text-[var(--text-default)]">{heading}</p>
    <p class="text-sm text-[var(--text-subdue)] leading-snug">{description}</p>
  </div>
  <div class="shrink-0">
    <slot />
  </div>
</Card>
