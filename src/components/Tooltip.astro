---
/**
 * Composant Tooltip - Info-bulle au survol
 * 
 * @description
 * Affiche un tooltip au survol long (500ms) d'un élément.
 * 
 * @props
 * @prop {string} text - Texte à afficher dans le tooltip
 * @prop {string} [position] - Position du tooltip (top, bottom, left, right)
 * @prop {number} [delay] - Délai avant affichage en ms (défaut: 500)
 */

interface Props {
  text: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  delay?: number;
}

const { text, position = 'top', delay = 500 } = Astro.props;
---

<div
  class="relative inline-block after:content-[attr(data-tooltip-text)] after:absolute after:py-1 after:px-2 after:text-sm after:bg-[var(--color-gray-900)] after:text-white after:rounded-sm after:whitespace-nowrap after:opacity-0 after:pointer-events-none after:[transition:opacity_200ms_ease] after:[transition-delay:calc(var(--tooltip-delay,500ms)+100ms)] after:z-50 hover:after:opacity-100 data-[tooltip-position=top]:after:bottom-full data-[tooltip-position=top]:after:left-1/2 data-[tooltip-position=top]:after:-translate-x-1/2 data-[tooltip-position=top]:after:mb-2 data-[tooltip-position=bottom]:after:top-full data-[tooltip-position=bottom]:after:left-1/2 data-[tooltip-position=bottom]:after:-translate-x-1/2 data-[tooltip-position=bottom]:after:mt-2 data-[tooltip-position=left]:after:right-full data-[tooltip-position=left]:after:top-1/2 data-[tooltip-position=left]:after:-translate-y-1/2 data-[tooltip-position=left]:after:mr-2 data-[tooltip-position=right]:after:left-full data-[tooltip-position=right]:after:top-1/2 data-[tooltip-position=right]:after:-translate-y-1/2 data-[tooltip-position=right]:after:ml-2"
  data-tooltip-text={text}
  data-tooltip-position={position}
  data-tooltip-delay={delay}
>
  <slot />
</div>

<script>
  // Appliquer le délai via CSS variable
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.tooltip-container').forEach(container => {
      const delay = container.dataset.tooltipDelay || 500;
      container.style.setProperty('--tooltip-delay', `${delay}ms`);
    });
  });
</script>
