---
import Action from "../components/Action.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === base || currentPath === base.slice(0, -1);
const relativePath = currentPath.startsWith(base)
  ? currentPath.slice(base.length)
  : currentPath.replace(/^\//, '');
---

<header class="site-header">
  <div class="header-inner">
    <a href={base} class="wordmark">
      <span class="wordmark-dot" />
      Sketching Tools
    </a>

    {!isHome && (
      <nav class="breadcrumb">
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-page">
          {relativePath.replace(/\/$/g, '').replace(/\//g, ' › ')}
        </span>
      </nav>
    )}

    <a href={`${base}/settings`} class="settings-link" aria-label="Réglages" title="Réglages">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M19.4 13a7.97 7.97 0 0 0 0-2l2.1-1.6-2-3.4-2.5 1a8 8 0 0 0-1.7-1L14.9 3h-4l-.4 2.6a8 8 0 0 0-1.7 1l-2.5-1-2 3.4L6.4 11a8 8 0 0 0 0 2l-2.1 1.6 2 3.4 2.5-1a8 8 0 0 0 1.7 1l.4 2.6h4l.4-2.6a8 8 0 0 0 1.7-1l2.5 1 2-3.4-2.1-1.6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 3.5rem;
    background: var(--color-gray-50);
    border-bottom: 1px solid var(--color-gray-400);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-gray-900);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .wordmark:hover { opacity: 0.7; }

  .wordmark-dot {
    width: 7px;
    height: 7px;
    background: #2563EB;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-sep {
    color: var(--color-gray-300);
    font-size: 0.9375rem;
  }

  .breadcrumb-page {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    text-transform: capitalize;
  }

  .settings-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: var(--color-gray-100);
    color: var(--color-gray-500);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .settings-link:hover {
    background: var(--color-gray-200);
    color: var(--color-gray-900);
  }
</style>
