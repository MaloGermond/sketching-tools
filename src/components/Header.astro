---
import Action from "../components/Action.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === base || currentPath === base.slice(0, -1);
const relativePath = currentPath.startsWith(base)
  ? currentPath.slice(base.length)
  : currentPath.replace(/^\//, '');
---

<header class="site-header">
  <div class="header-inner">
    <a href={base} class="wordmark">
      <span class="wordmark-dot" />
      Sketching Tools
    </a>

    {!isHome && (
      <nav class="breadcrumb">
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-page">
          {relativePath.replace(/\/$/g, '').replace(/\//g, ' › ')}
        </span>
      </nav>
    )}

    <a href={`${base}/settings`} class="settings-link" aria-label="Réglages" title="Réglages">
      <Icon name="settings" size={16} />
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 3.5rem;
    background: var(--background);
    border-bottom: 1px solid var(--border-subdue);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-default);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .wordmark:hover { opacity: 0.7; }

  .wordmark-dot {
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-sep {
    color: var(--border-default);
    font-size: 0.9375rem;
  }

  .breadcrumb-page {
    font-size: var(--text-sm);
    color: var(--text-subdue);
    text-transform: capitalize;
  }

  .settings-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: var(--surface-subdue);
    color: var(--text-subdue);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .settings-link:hover {
    background: var(--surface-default);
    color: var(--text-default);
  }
</style>
