---
import Action from "../components/Action.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === base || currentPath === base.slice(0, -1);
const relativePath = currentPath.startsWith(base)
  ? currentPath.slice(base.length)
  : currentPath.replace(/^\//, '');
---

<header class="fixed top-0 left-0 right-0 z-50 h-14 bg-[var(--background)] border-b border-[var(--border-subdue)]">
  <div class="flex items-center gap-2 h-full py-0 px-6 max-w-[80rem] mx-auto">
    <a href={base} class="inline-flex items-center gap-2 text-[0.9375rem] font-medium text-[var(--text-default)] no-underline [transition:opacity_150ms_ease] hover:opacity-70">
      <span class="w-[7px] h-[7px] bg-[var(--color-accent)] rounded-full shrink-0" />
      Sketching Tools
    </a>

    {!isHome && (
      <nav class="flex items-center gap-2">
        <span class="text-[var(--border-default)] text-[0.9375rem]">/</span>
        <span class="text-sm text-[var(--text-subdue)] capitalize">
          {relativePath.replace(/\/$/g, '').replace(/\//g, ' › ')}
        </span>
      </nav>
    )}

    <a
      href={`${base}/settings`}
      class="ml-auto inline-flex items-center justify-center w-8 h-8 rounded-xs bg-[var(--surface-subdue)] text-[var(--text-subdue)] [transition:background-color_150ms_ease,color_150ms_ease] hover:bg-[var(--surface-default)] hover:text-[var(--text-default)]"
      aria-label="Réglages"
      title="Réglages"
    >
      <Icon name="settings" size={16} />
    </a>
  </div>
</header>
