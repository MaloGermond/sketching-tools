---
import ToggleGroup from './ToggleGroup.jsx';

interface Props {
  icons?: string[];
  selectedIcon?: string;
}

const {
  icons = ['circle', 'ellipse', 'square', 'triangle', 'horizontal-line', 'vertical-line'],
  selectedIcon = ''
} = Astro.props;

// Split icons into two groups with a separator (first 3 | last 3)
const group1 = icons.slice(0, 3);
const group2 = icons.slice(3);
---

<div class="toolbar">
  <ToggleGroup
    client:load
    icons={icons}
    selectedIcon={selectedIcon}
    groupId="shape-toggle-group"
  />
</div>

<style>
  .toolbar {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background: #ffffff;
    border-radius: 9999px;
    padding: 0.875rem 1rem;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08), 0 1px 4px rgb(0 0 0 / 0.04);
    border: 1px solid var(--color-gray-200);
    display: flex;
    align-items: center;
    max-width: calc(100vw - 2rem);
  }

  /* Breakpoints mutuellement exclusifs : pas de dépendance à l'ordre du bundler CSS */

  /* Mobile: 2-3 outils principaux, cibles tactiles agrandies */
  @media (max-width: 767px) {
    .toolbar :global(#shape-toggle-group > button:nth-of-type(n+4)) {
      display: none;
    }

    .toolbar :global(.toggle-btn) {
      width: 44px !important;
      height: 44px !important;
    }
  }

  /* Tablette: davantage d'outils, taille intermédiaire (usage stylet) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .toolbar :global(#shape-toggle-group > button:nth-of-type(n+6)) {
      display: none;
    }

    .toolbar :global(.toggle-btn) {
      width: 40px !important;
      height: 40px !important;
    }
  }

  /* Ordinateur: tous les outils, taille compacte (usage souris/tablette graphique) */
  @media (min-width: 1024px) {
    .toolbar :global(.toggle-btn) {
      width: 36px !important;
      height: 36px !important;
    }
  }
</style>
