---

import Toggle from './Toggle.astro';
import Card from './Card.astro';

---

<Card class="border-1 border-gray-200 absolute bottom-1 left-1/2 -translate-x-1/2">
	<div class="flex gap-2">
		<Toggle icon="circle"></Toggle>
		<Toggle icon="ellipse"></Toggle>
		<Toggle icon="rectangle"></Toggle>
		<Toggle icon="triangle"></Toggle>
		<Toggle icon="line-horizontal"></Toggle>
		<Toggle icon="line-vertical"></Toggle>
	</div>
</Card>