---
interface Props {
  // false pour un rendu en flux normal (ex. page composants) plutôt qu'ancré en bas d'écran
  fixed?: boolean;
}

const { fixed = true } = Astro.props;

const baseClasses = 'flex items-center gap-4 py-3 px-4 bg-[var(--surface-raised)] border border-[var(--border-subdue)] rounded-3xl shadow-[0_0_28px_rgb(0_0_0_/_0.16)] max-w-[calc(100vw-2rem)]';
const toolbarClasses = fixed
  ? `${baseClasses} fixed bottom-6 left-1/2 -translate-x-1/2 z-10 animate-[toolbar-appear-fixed_0.22s_ease-out_0.3s_both]`
  : `${baseClasses} animate-[toolbar-appear_0.22s_ease-out_0.3s_both]`;
---

<div class={toolbarClasses}>
  <slot />
</div>
