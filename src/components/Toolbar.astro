---
interface Props {
  // false pour un rendu en flux normal (ex. page composants) plutôt qu'ancré en bas d'écran
  fixed?: boolean;
}

const { fixed = true } = Astro.props;
---

<div class={`toolbar ${fixed ? 'toolbar--fixed' : ''}`}>
  <slot />
</div>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--surface-raised);
    border: 1px solid var(--border-subdue);
    border-radius: 1.5rem;
    box-shadow: 0 0 28px rgb(0 0 0 / 0.16);
    max-width: calc(100vw - 2rem);
  }

  .toolbar--fixed {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }
</style>
