---
/**
 * Composant Toolbar - Barre d'outils fixe en bas de l'écran
 * 
 * @description
 * Une barre d'outils positionnée fixement en bas de l'écran, centrée horizontalement.
 * Contient un groupe de boutons toggle pour sélectionner des outils de dessin.
 * Agnostique : la logique de gestion est dans ToggleGroup.
 */

import ToggleGroup from './ToggleGroup.astro';
import Card from './Card.astro';

interface Props {
  selectedIcon?: string;
}

const { selectedIcon = '' } = Astro.props;
---

<Card id="drawing-toolbar" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-10 border border-gray-200">
	<ToggleGroup 
    icons={['circle', 'ellipse', 'square', 'triangle', 'horizontal-line', 'vertical-line']}
    selectedIcon={selectedIcon}
    groupId="shape-toggle-group"
  />
</Card>
