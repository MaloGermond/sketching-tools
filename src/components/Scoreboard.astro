---
// Composant Scoreboard - Affiche la moyenne et l'historique des scores
// Inclut la Card et le titre
import Card from "./Card.astro";

interface Props {
  style?: string;
}

const { style = "" } = Astro.props;
---

<Card style={style}>
  <h3 class="text-lg">Journal</h3>
  <div id="scoreboard" class="scoreboard">
    <div class="scoreboard-average text-sm">
      Score: <span id="score-average" class="text-lg">0%</span>
    </div>
    <!-- <div class="scoreboard-history" id="score-history"></div> -->
  </div>
</Card>

<script>
  // Fonction pour rendre le scoreboard à partir de window.scoreState
  function renderScoreboard() {
    const state = window.scoreState || { average: 0, history: [], current: null };
    
    const averageEl = document.getElementById('score-average');
    const historyEl = document.getElementById('score-history');
    
    if (averageEl) {
      averageEl.textContent = `${state.average}%`;
    }
    
    if (historyEl) {
      if (state.history.length > 0) {
        historyEl.innerHTML = state.history
          .slice()
          .reverse()
          .map((score, i) => `<div class="score-item">#${i+1}: ${score}%</div>`)
          .join('');
      } else {
        historyEl.innerHTML = '<div class="score-empty">Aucun score encore</div>';
      }
    }
  }
  
  // Initialiser le scoreboard
  if (typeof window !== 'undefined') {
    // Initialiser avec des valeurs par défaut
    window.scoreState = window.scoreState || { average: 0, history: [], current: null };
    renderScoreboard();
    
    // Écouter les mises à jour
    document.addEventListener('scoreUpdated', renderScoreboard);
  }
</script>

