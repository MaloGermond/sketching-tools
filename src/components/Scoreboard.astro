---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<aside class:list={['scoreboard', className]}>
  <div id="trace-history" class="trace-list"></div>
  <div class="score-card" id="score-card">
    <div class="score-thumbnail-wrapper">
      <div class="score-thumbnail-placeholder" id="score-thumbnail-img"></div>
    </div>
    <div class="score-info">
      <p class="score-label">Ressemblance</p>
      <div class="score-row">
        <span id="score-average" class="score-value">—</span>
        <span class="score-dot" id="score-dot"></span>
      </div>
    </div>
  </div>
</aside>

<style>
  .scoreboard {
    position: fixed;
    left: 1rem;
    bottom: 1.5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 5rem;
  }

  /* History column — older entries at top, most recent at bottom */
  .trace-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  /* Score card — current/latest */
  .score-card {
    background: #ffffff;
    border: 1px solid var(--color-gray-200);
    border-radius: 1rem;
    padding: 0.625rem;
    width: 100%;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .score-thumbnail-wrapper {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
  }

  .score-thumbnail-placeholder {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .score-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .score-label {
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-gray-400);
    letter-spacing: 0.02em;
  }

  .score-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .score-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1;
  }

  .score-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gray-200);
    transition: background 200ms ease;
    flex-shrink: 0;
  }
</style>

<style is:global>
  .trace-thumb {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0.875rem;
    overflow: hidden;
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
    flex-shrink: 0;
  }

  .trace-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

<script>
  function renderScoreboard() {
    const state = window.scoreState || { average: 0, history: [], current: null, traces: [] };

    const averageEl = document.getElementById('score-average');
    const dotEl = document.getElementById('score-dot');
    const imgEl = document.getElementById('score-thumbnail-img');
    const historyEl = document.getElementById('trace-history');

    const traces = state.traces || [];
    const latest = traces[traces.length - 1];
    const history = traces.slice(0, -1).slice(-4); // up to 4 older entries

    // Update current score card
    if (averageEl) {
      const avg = state.average || 0;
      averageEl.textContent = avg > 0 ? `${avg}%` : '—';
    }

    if (dotEl && latest) {
      const score = Math.floor(latest.score);
      dotEl.style.background =
        score >= 80 ? '#22c55e' :
        score >= 50 ? '#f59e0b' :
        '#ef4444';
    }

    if (imgEl && latest?.image) {
      imgEl.style.backgroundImage = `url(${latest.image})`;
    }

    // Render history (older = more transparent)
    if (historyEl) {
      const opacities = [0.15, 0.25, 0.4, 0.6];
      const startOpacity = opacities[Math.max(0, opacities.length - history.length)];

      historyEl.innerHTML = history.map((trace, i) => {
        const opacity = opacities[opacities.length - history.length + i] ?? 0.6;
        return `
          <div class="trace-thumb" style="opacity: ${opacity}">
            <img src="${trace.image}" alt="Tracé ${i + 1}" />
          </div>
        `;
      }).join('');
    }
  }

  if (typeof window !== 'undefined') {
    window.scoreState = window.scoreState || { average: 0, history: [], current: null, traces: [] };
    renderScoreboard();
    document.addEventListener('scoreUpdated', renderScoreboard);
  }
</script>
