---
// Composant Scoreboard - Affiche la moyenne et l'historique des scores avec images
// Inclut la Card et le titre
import Card from "./Card.astro";

interface Props {
  style?: string;
}

const { style = "" } = Astro.props;
---

<Card style={style}>
  <h3 class="text-lg font-semibold">Journal</h3>
  <div class="flex flex-col gap-4 min-w-[200px]">
    <div class="flex items-baseline gap-2">
      <span class="text-sm">Moyenne:</span>
      <span id="score-average" class="text-xl font-bold ml-2">0%</span>
    </div>
    
    <div id="trace-history" class="flex flex-col gap-3 max-h-[400px] overflow-y-auto"></div>
  </div>
</Card>

<style>
  /* Styles pour les éléments dynamiques générés par JavaScript */
  /* Équivalents aux classes Tailwind pour éviter les problèmes avec @apply */
  :global(.trace-item) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: white;
    border-radius: 0.375rem;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  
  :global(.trace-image) {
    width: 50px;
    height: 50px;
    object-fit: contain;
    background: #F6F6F6;
    border-radius: 0.375rem;
    border: 1px solid #E6E6E6;
  }
  
  :global(.trace-score) {
    font-weight: 600;
    font-size: 0.875rem;
  }
  
  :global(.trace-score.high) { color: #8b5cf6; }
  :global(.trace-score.medium) { color: #f59e0b; }
  :global(.trace-score.low) { color: #ef4444; }
  
  :global(.trace-empty) {
    color: #9ca3af;
    font-size: 0.875rem;
    text-align: center;
    padding: 1rem;
  }
</style>

<script>
  // Fonction pour rendre le scoreboard avec les images
  function renderScoreboard() {
    const state = window.scoreState || { 
      average: 0, 
      history: [], 
      current: null,
      traces: []
    };
    
    const averageEl = document.getElementById('score-average');
    const historyEl = document.getElementById('trace-history');
    
    if (averageEl) {
      averageEl.textContent = `${state.average}%`;
    }
    
    if (historyEl) {
      if (state.traces && state.traces.length > 0) {
        // Afficher les traces avec leurs images et scores
        historyEl.innerHTML = state.traces
          .slice(0, 20)
          .map((trace, i) => {
            const score = Math.floor(trace.score);
            const scoreClass = score >= 80 ? 'high' : score >= 50 ? 'medium' : 'low';
            return `
              <article class="trace-item">
                <img class="trace-image" src="${trace.image}" alt="Tracé ${i + 1}" />
                <span class="trace-score ${scoreClass}">${score}%</span>
              </article>
            `;
          })
          .join('');
      } else {
        historyEl.innerHTML = '<div class="trace-empty">Aucun tracé encore</div>';
      }
    }
  }
  
  // Initialiser le scoreboard
  if (typeof window !== 'undefined') {
    window.scoreState = window.scoreState || { 
      average: 0, 
      history: [], 
      current: null,
      traces: []
    };
    renderScoreboard();
    
    // Écouter les mises à jour
    document.addEventListener('scoreUpdated', renderScoreboard);
  }
</script>
